<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Meta name="ExplicitAutoJoints">true</Meta><External>null</External><External>nil</External><Item class="Folder" referent="RBX18"><Properties><string name="Name">Builders</string></Properties><Item class="ModuleScript" referent="RBX15"><Properties><string name="Name">MapBuilder</string><ProtectedString name="Source"><![CDATA[--[[
	MapBuilder (ModuleScript)
	Emplacement : ServerScriptService > Builders > MapBuilder

	Génère tout le décor dans Workspace > Map :
	sol, chemins, zones de slimes, arbres (5 styles au choix dans MapConfig), rochers,
	buissons, fleurs, barrières low poly tout autour, nuages, tapis roulant, spawn.
	Appelé par Main au démarrage (sauf si Workspace.Map existe déjà).

	Astuce : pour "figer" la map et la modifier à la main dans Studio, tape dans la
	barre de commande :  require(game.ServerScriptService.Builders.MapBuilder).Build()

	Modèles externes (facultatif) : si ReplicatedStorage > Assets > TreeModels contient des
	modèles (importés depuis le Creator Store ou un fichier .fbx), ils remplacent les arbres générés.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")
local GameConfig = require(ReplicatedStorage.Config.GameConfig)
local MapConfig = require(ReplicatedStorage.Config.MapConfig)
local SlimeConfig = require(ReplicatedStorage.Config.SlimeConfig)
local Util = require(ReplicatedStorage.Shared.Util)

local MapBuilder = {}

local GRASS_COLOR = MapConfig.Ground.Color
local PATH_COLOR = MapConfig.PathColor
local BARK = Color3.fromRGB(110, 72, 40)

---------------------------------------------------------------------------
-- Outils
---------------------------------------------------------------------------
local function newPart(name, size, cframe, color, material, parent)
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

local function newBall(name, diameter, position, color, parent)
	local part = newPart(name, Vector3.new(diameter, diameter, diameter), CFrame.new(position), color, Enum.Material.SmoothPlastic, parent)
	part.Shape = Enum.PartType.Ball
	part.CanCollide = false
	return part
end

-- Ellipsoïde (sphère étirée) grâce à un SpecialMesh
local function newEllipsoid(name, size, cframe, color, parent)
	local part = newPart(name, size, cframe, color, Enum.Material.SmoothPlastic, parent)
	part.CanCollide = false
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = part
	return part
end

-- Cylindre vertical (l'axe d'un Cylinder Roblox est X : on le redresse)
local UPRIGHT = CFrame.Angles(0, 0, math.rad(90))
local function newColumn(name, height, diameter, position, color, parent, tilt)
	local cframe = CFrame.new(position) * (tilt or CFrame.new()) * UPRIGHT
	local part = newPart(name, Vector3.new(height, diameter, diameter), cframe, color, Enum.Material.SmoothPlastic, parent)
	part.Shape = Enum.PartType.Cylinder
	return part
end

-- Cylindre entre deux points (branches)
local function newBeam(name, from, to, diameter, color, parent)
	local length = (to - from).Magnitude
	local mid = (from + to) / 2
	local cframe = CFrame.lookAt(mid, to) * CFrame.Angles(0, math.rad(90), 0)
	local part = newPart(name, Vector3.new(length, diameter, diameter), cframe, color, Enum.Material.SmoothPlastic, parent)
	part.Shape = Enum.PartType.Cylinder
	part.CanCollide = false
	return part
end

local function folder(name, parent)
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

---------------------------------------------------------------------------
-- Sol, chemins, zones, spawn
---------------------------------------------------------------------------
local function buildGround(map)
	local g = MapConfig.Ground
	newPart("Ground", g.Size, CFrame.new(g.Center), g.Color, g.Material, map)
end

local function buildPaths(map)
	local paths = folder("Paths", map)
	newPart("MainPath", Vector3.new(12, 0.2, 480), CFrame.new(0, 0.1, -160), PATH_COLOR, Enum.Material.SmoothPlastic, paths)
	local conveyor = GameConfig.Conveyor
	newPart("ConveyorPath", Vector3.new(conveyor.Length + 16, 0.2, conveyor.Width + 16), CFrame.new(conveyor.Center + Vector3.new(0, 0.1, 0)), PATH_COLOR, Enum.Material.SmoothPlastic, paths)
	newPart("SpawnPlaza", Vector3.new(40, 0.2, 30), CFrame.new(GameConfig.SpawnPosition.X, 0.1, GameConfig.SpawnPosition.Z), PATH_COLOR, Enum.Material.SmoothPlastic, paths)
end

local function buildZones(map)
	local zones = folder("Zones", map)
	for _, def in ipairs(SlimeConfig.List) do
		local center = def.ZonePosition
		local diameter = def.ZoneRadius * 2
		local color = def.Color:Lerp(GRASS_COLOR, 0.55)
		local disc = newPart("Zone_" .. def.Id, Vector3.new(0.3, diameter, diameter), CFrame.new(center.X, 0.15, center.Z) * UPRIGHT, color, Enum.Material.SmoothPlastic, zones)
		disc.Shape = Enum.PartType.Cylinder
		-- Anneau de bordure (disque légèrement plus grand et plus foncé, dessous)
		local ring = newPart("ZoneRing_" .. def.Id, Vector3.new(0.2, diameter + 3, diameter + 3), CFrame.new(center.X, 0.1, center.Z) * UPRIGHT, color:Lerp(Color3.new(0, 0, 0), 0.25), Enum.Material.SmoothPlastic, zones)
		ring.Shape = Enum.PartType.Cylinder

		-- Panneau
		newPart("Sign_" .. def.Id, Vector3.new(0.6, 5, 0.6), CFrame.new(center.X + 9, 2.5, center.Z + def.ZoneRadius), Color3.fromRGB(110, 70, 35), Enum.Material.Wood, zones)
		local board = newPart("Board", Vector3.new(6, 3, 0.4), CFrame.new(center.X + 9, 5.5, center.Z + def.ZoneRadius), Color3.fromRGB(160, 110, 60), Enum.Material.Wood, zones)
		local gui = Instance.new("BillboardGui")
		gui.Size = UDim2.fromOffset(260, 110)
		gui.StudsOffsetWorldSpace = Vector3.new(0, 3.5, 0)
		gui.MaxDistance = 160
		gui.LightInfluence = 0
		gui.Adornee = board
		gui.Parent = board
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(1, 1)
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.TextColor3 = Color3.new(1, 1, 1)
		label.Text = string.format("Zone %d\n%s\n%s PV  ·  %s $", def.Index, def.Name, Util.FormatNumber(def.Health), Util.FormatNumber(def.Reward))
		label.Parent = gui
		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 2.5
		stroke.Color = Color3.new(0, 0, 0)
		stroke.Parent = label
	end
end

local function buildSpawn(map)
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "Spawn"
	spawn.Size = Vector3.new(10, 1, 10)
	spawn.CFrame = CFrame.new(GameConfig.SpawnPosition.X, 0.5, GameConfig.SpawnPosition.Z)
	spawn.Anchored = true
	spawn.Color = Color3.fromRGB(245, 150, 40)
	spawn.Material = Enum.Material.SmoothPlastic
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Duration = 0
	spawn.Parent = map
end

---------------------------------------------------------------------------
-- Arbres : 5 styles
---------------------------------------------------------------------------
local LEAF_PALETTES = {
	{ Color3.fromRGB(52, 150, 68), Color3.fromRGB(70, 180, 82), Color3.fromRGB(96, 208, 104) }, -- vert classique
	{ Color3.fromRGB(62, 170, 92), Color3.fromRGB(88, 200, 110), Color3.fromRGB(120, 225, 130) }, -- vert clair
	{ Color3.fromRGB(46, 140, 80), Color3.fromRGB(60, 165, 90), Color3.fromRGB(80, 190, 100) }, -- vert profond
	{ Color3.fromRGB(150, 200, 70), Color3.fromRGB(175, 220, 85), Color3.fromRGB(200, 235, 110) }, -- vert citron
	{ Color3.fromRGB(230, 140, 60), Color3.fromRGB(245, 170, 80), Color3.fromRGB(255, 200, 110) }, -- automne
	{ Color3.fromRGB(230, 120, 150), Color3.fromRGB(245, 150, 180), Color3.fromRGB(255, 185, 205) }, -- cerisier
}

-- Palettes vertes surtout, avec quelques arbres colorés (automne, cerisier)
local function pickPalette(rng)
	local roll = rng:NextNumber()
	if roll < 0.08 then
		return LEAF_PALETTES[6]
	elseif roll < 0.18 then
		return LEAF_PALETTES[5]
	end
	return LEAF_PALETTES[rng:NextInteger(1, 4)]
end

local BARK_DARK = Color3.fromRGB(82, 52, 28)

-- Tronc travaillé : effilé en 3 segments (droit ou tordu), écorce striée, nœud, racines effilées.
-- Retourne le sommet du tronc.
local function buildTrunk(model, position, rng, scale, yaw, height, style)
	style = style or MapConfig.TrunkStyle
	local bark = Color3.fromRGB(110 + rng:NextInteger(-12, 12), 72 + rng:NextInteger(-8, 8), 40)
	local segments = 3
	local segmentHeight = height / segments
	local point = position
	local tilt = 0
	local facing = CFrame.Angles(0, yaw, 0)

	for i = 1, segments do
		if style == "Twisted" then
			tilt = tilt + rng:NextNumber(-0.14, 0.14)
		end
		local diameter = (2.3 - (i - 0.5) * 0.45) * scale
		local step = facing * Vector3.new(math.sin(tilt) * segmentHeight, math.cos(tilt) * segmentHeight, 0)
		local mid = point + step / 2
		local segment = newPart("Trunk", Vector3.new(segmentHeight + 0.25 * scale, diameter, diameter), CFrame.lookAt(mid, point + step) * CFrame.Angles(0, math.rad(90), 0), bark, Enum.Material.SmoothPlastic, model)
		segment.Shape = Enum.PartType.Cylinder

		-- Stries d'écorce (fines lattes plus foncées collées au tronc)
		if style ~= "Smooth" then
			for s = 1, 3 do
				local angle = yaw + s * 2.1 + i * 0.7
				local radial = Vector3.new(math.cos(angle), 0, math.sin(angle))
				local ridge = newPart("Bark", Vector3.new(0.16 * scale, segmentHeight * 0.75, 0.42 * scale), CFrame.new(mid + radial * (diameter / 2 * 0.92)) * CFrame.Angles(0, -angle, 0), BARK_DARK, Enum.Material.SmoothPlastic, model)
				ridge.CanCollide = false
			end
		end
		point = point + step
	end

	-- Nœud dans le bois
	if style ~= "Smooth" then
		local angle = yaw + 1.2
		newEllipsoid("Knot", Vector3.new(0.3 * scale, 0.55 * scale, 0.55 * scale), CFrame.new(position + Vector3.new(math.cos(angle) * 0.95 * scale, height * 0.42, math.sin(angle) * 0.95 * scale)) * CFrame.Angles(0, -angle, 0), BARK_DARK, model)
	end

	-- Racines effilées (gros bloc incliné + petit bloc au bout)
	local rootCount = rng:NextInteger(3, 4)
	for r = 1, rootCount do
		local angle = yaw + r * (math.pi * 2 / rootCount) + rng:NextNumber(-0.3, 0.3)
		local radial = Vector3.new(math.cos(angle), 0, math.sin(angle))
		local rotation = CFrame.Angles(0, -angle + math.rad(90), 0)
		local big = newPart("Root", Vector3.new(0.8, 0.8, 2.0) * scale, CFrame.new(position + radial * 1.5 * scale + Vector3.new(0, 0.35 * scale, 0)) * rotation * CFrame.Angles(math.rad(-18), 0, 0), bark, Enum.Material.SmoothPlastic, model)
		big.CanCollide = false
		local small = newPart("Root", Vector3.new(0.45, 0.4, 1.3) * scale, CFrame.new(position + radial * 2.9 * scale + Vector3.new(0, 0.15 * scale, 0)) * rotation * CFrame.Angles(math.rad(-8), 0, 0), bark, Enum.Material.SmoothPlastic, model)
		small.CanCollide = false
	end
	return point, bark
end

-- A : boules étagées (variantes : ronde, haute, large)
local function treeA(model, position, rng, scale, yaw)
	local variant = rng:NextInteger(1, 3) -- 1 ronde, 2 haute, 3 large
	local trunkHeight = (variant == 2 and 9 or 7.4) * scale
	local top, bark = buildTrunk(model, position, rng, scale, yaw, trunkHeight)
	local palette = pickPalette(rng)
	local crownY = top.Y + 1.0 * scale

	-- Une ou deux branches avec une petite touffe au bout
	for b = 1, rng:NextInteger(1, 2) do
		local angle = yaw + b * 2.4 + rng:NextNumber(0, 0.8)
		local endPoint = top + Vector3.new(math.cos(angle) * 3.2 * scale, -0.6 * scale, math.sin(angle) * 3.2 * scale)
		newBeam("Branch", top - Vector3.new(0, 0.8 * scale, 0), endPoint, 0.55 * scale, bark, model)
		newBall("Leaves", 2.4 * scale, endPoint + Vector3.new(0, 0.6 * scale, 0), palette[3], model)
	end

	if variant == 1 then
		newBall("Leaves", 7.5 * scale, Vector3.new(top.X, crownY, top.Z), palette[1], model)
		local ringCount = rng:NextInteger(4, 6)
		for i = 1, ringCount do
			local angle = yaw + i * (math.pi * 2 / ringCount)
			newBall("Leaves", rng:NextNumber(4.2, 5.4) * scale, Vector3.new(top.X + math.cos(angle) * 2.6 * scale, crownY - 0.9 * scale + rng:NextNumber(-0.4, 0.6) * scale, top.Z + math.sin(angle) * 2.6 * scale), palette[(i % 2) + 1], model)
		end
		newBall("Leaves", 4.4 * scale, Vector3.new(top.X + 0.4 * scale, crownY + 2.8 * scale, top.Z - 0.3 * scale), palette[3], model)
	elseif variant == 2 then
		-- Haute : boules empilées de plus en plus petites
		local sizes = { 6.4, 5.4, 4.4, 3.2 }
		local y = crownY - 0.5 * scale
		for i, d in ipairs(sizes) do
			local offset = Vector3.new(rng:NextNumber(-0.6, 0.6), 0, rng:NextNumber(-0.6, 0.6)) * scale
			newBall("Leaves", d * scale, Vector3.new(top.X, y, top.Z) + offset, palette[((i - 1) % 3) + 1], model)
			y = y + d * scale * 0.55
		end
	else
		-- Large : couronne aplatie de grosses boules
		local ringCount = rng:NextInteger(5, 7)
		for i = 1, ringCount do
			local angle = yaw + i * (math.pi * 2 / ringCount)
			newBall("Leaves", rng:NextNumber(4.8, 5.8) * scale, Vector3.new(top.X + math.cos(angle) * 3.6 * scale, crownY - 0.6 * scale + rng:NextNumber(-0.3, 0.3) * scale, top.Z + math.sin(angle) * 3.6 * scale), palette[(i % 2) + 1], model)
		end
		newBall("Leaves", 6.6 * scale, Vector3.new(top.X, crownY + 0.9 * scale, top.Z), palette[3], model)
	end
end

-- B : low poly facetté (cubes tournés en cristaux de feuillage, agencement aléatoire)
local function treeB(model, position, rng, scale, yaw)
	local top, _ = buildTrunk(model, position, rng, scale, yaw, 7.6 * scale)
	local palette = pickPalette(rng)
	local crownY = top.Y + 2.0 * scale
	local mainSize = rng:NextNumber(5.8, 7.2) * scale
	local main = newPart("Leaves", Vector3.new(mainSize, mainSize, mainSize), CFrame.new(top.X, crownY, top.Z) * CFrame.Angles(rng:NextNumber(0.3, 0.8), yaw, rng:NextNumber(0.3, 0.8)), palette[1], Enum.Material.SmoothPlastic, model)
	main.CanCollide = false
	local satellites = rng:NextInteger(3, 6)
	for i = 1, satellites do
		local angle = yaw + i * (math.pi * 2 / satellites) + rng:NextNumber(-0.4, 0.4)
		local elevation = rng:NextNumber(-0.5, 0.9)
		local distance = rng:NextNumber(2.4, 3.4) * scale
		local size = rng:NextNumber(3.0, 4.8) * scale
		local offset = Vector3.new(math.cos(elevation) * math.cos(angle) * distance, math.sin(elevation) * distance, math.cos(elevation) * math.sin(angle) * distance)
		local cube = newPart("Leaves", Vector3.new(size, size, size), CFrame.new(Vector3.new(top.X, crownY, top.Z) + offset) * CFrame.Angles(rng:NextNumber(0.2, 0.9), rng:NextNumber(0, 3), rng:NextNumber(0.3, 0.9)), palette[(i % 2) + 2], Enum.Material.SmoothPlastic, model)
		cube.CanCollide = false
	end
end

-- C : sapin à étages (blocs tournés à 45°, de plus en plus petits)
local function treeC(model, position, rng, scale, yaw)
	newColumn("Trunk", 4 * scale, 1.3 * scale, position + Vector3.new(0, 2 * scale, 0), BARK, model)
	local greens = { Color3.fromRGB(34, 110, 70), Color3.fromRGB(40, 130, 78), Color3.fromRGB(52, 150, 86), Color3.fromRGB(70, 175, 96) }
	local tiers = { { 7.5, 2.6 }, { 6.0, 2.4 }, { 4.6, 2.2 }, { 3.2, 2.0 }, { 1.9, 1.8 } }
	local y = 3.2 * scale
	for i, tier in ipairs(tiers) do
		local w, h = tier[1] * scale, tier[2] * scale
		local color = greens[math.min(i, 4)]
		local outer = newPart("Leaves", Vector3.new(w, h, w), CFrame.new(position + Vector3.new(0, y + h / 2, 0)) * CFrame.Angles(0, yaw + math.rad(45), 0), color, Enum.Material.SmoothPlastic, model)
		outer.CanCollide = false
		local inner = newPart("Leaves", Vector3.new(w * 0.8, h * 0.9, w * 0.8), CFrame.new(position + Vector3.new(0, y + h / 2 + 0.1, 0)) * CFrame.Angles(0, yaw, 0), color, Enum.Material.SmoothPlastic, model)
		inner.CanCollide = false
		y = y + h * 0.75
	end
	newBall("Star", 1.2 * scale, position + Vector3.new(0, y + 0.8 * scale, 0), Color3.fromRGB(255, 220, 80), model)
end

-- D : parasol / acacia (tronc incliné, branches, canopées plates)
local function treeD(model, position, rng, scale, yaw)
	local trunkH = 6 * scale
	local lean = CFrame.Angles(0, yaw, 0) * CFrame.Angles(0, 0, math.rad(10))
	newColumn("Trunk", trunkH, 1.4 * scale, position + Vector3.new(0, trunkH / 2, 0), BARK, model, lean)
	local top = position + (CFrame.Angles(0, yaw, 0) * Vector3.new(-1.0 * scale, trunkH, 0))
	local palette = pickPalette(rng)
	local canopies = { { -3.2, 1.6, -1.0, 7.5 }, { 2.6, 0.9, 1.4, 6.5 }, { 0.4, 2.8, -2.6, 5.5 }, { 0.6, 3.4, 2.2, 4.8 } }
	for i, c in ipairs(canopies) do
		local offset = CFrame.Angles(0, yaw, 0) * Vector3.new(c[1] * scale, c[2] * scale, c[3] * scale)
		local endPoint = top + offset
		newBeam("Branch", top, endPoint, 0.6 * scale, BARK, model)
		newEllipsoid("Leaves", Vector3.new(c[4] * scale, 1.6 * scale, c[4] * scale), CFrame.new(endPoint + Vector3.new(0, 0.5 * scale, 0)), palette[(i % 2) + 1], model)
	end
end

-- E : palmier (tronc courbé en segments, palmes, noix de coco)
local function treeE(model, position, rng, scale, yaw)
	local direction = CFrame.Angles(0, yaw, 0)
	local point = position
	local tilt = 0.05
	local trunkColor = Color3.fromRGB(150, 110, 70)
	for i = 0, 5 do
		local h = 1.9 * scale
		local step = direction * Vector3.new(math.sin(tilt) * h, math.cos(tilt) * h, 0)
		local mid = point + step / 2
		local segment = newPart("Trunk", Vector3.new(h, (1.4 - i * 0.1) * scale, (1.4 - i * 0.1) * scale), CFrame.lookAt(mid, point + step) * CFrame.Angles(0, math.rad(90), 0), trunkColor, Enum.Material.SmoothPlastic, model)
		segment.Shape = Enum.PartType.Cylinder
		point = point + step
		tilt = tilt + 0.07
	end
	local palette = pickPalette(rng)
	for i = 1, 7 do
		local angle = yaw + i * (math.pi * 2 / 7)
		local leaf = newPart("Leaf", Vector3.new(6.5 * scale, 0.25 * scale, 1.6 * scale), CFrame.new(point + Vector3.new(math.cos(angle) * 3 * scale, 0.6 * scale, math.sin(angle) * 3 * scale)) * CFrame.Angles(0, -angle, math.rad(-25)), palette[(i % 2) + 1], Enum.Material.SmoothPlastic, model)
		leaf.CanCollide = false
	end
	for i = 1, 3 do
		local angle = i * 2.1
		newBall("Coconut", 0.9 * scale, point + Vector3.new(math.cos(angle) * 0.8 * scale, -0.3 * scale, math.sin(angle) * 0.8 * scale), Color3.fromRGB(90, 60, 30), model)
	end
end

local TREE_BUILDERS = { A = treeA, B = treeB, C = treeC, D = treeD, E = treeE }

local function externalTreeModels()
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local treeFolder = assets and assets:FindFirstChild("TreeModels")
	if treeFolder and #treeFolder:GetChildren() > 0 then
		return treeFolder:GetChildren()
	end
	return nil
end

local function buildTree(parent, position, rng)
	local model = Instance.new("Model")
	model.Name = "Tree"
	model.Parent = parent
	local yaw = rng:NextNumber(0, math.pi * 2)

	local external = externalTreeModels()
	if external then
		local clone = external[rng:NextInteger(1, #external)]:Clone()
		clone:PivotTo(CFrame.new(position) * CFrame.Angles(0, yaw, 0))
		clone.Parent = model
		return model
	end

	local styles = MapConfig.TreeStyles
	local style = styles[rng:NextInteger(1, #styles)]
	local builder = TREE_BUILDERS[style] or treeA
	builder(model, position, rng, rng:NextNumber(0.8, 1.5), yaw)
	return model
end

---------------------------------------------------------------------------
-- Rochers, buissons, fleurs
---------------------------------------------------------------------------
local function buildRock(parent, position, rng)
	local model = Instance.new("Model")
	model.Name = "Rock"
	model.Parent = parent
	local grey = 110 + rng:NextInteger(-15, 20)
	local color = Color3.fromRGB(grey, grey, grey + 8)
	local size = Vector3.new(rng:NextNumber(3, 6), rng:NextNumber(2.2, 4.2), rng:NextNumber(3, 6))
	local rotation = CFrame.Angles(math.rad(rng:NextNumber(-14, 14)), rng:NextNumber(0, math.pi * 2), math.rad(rng:NextNumber(-14, 14)))
	newPart("Rock", size, CFrame.new(position + Vector3.new(0, size.Y * 0.35, 0)) * rotation, color, Enum.Material.Slate, model)
	for _ = 1, 2 do
		local angle = rng:NextNumber(0, math.pi * 2)
		local small = Vector3.new(rng:NextNumber(1.2, 2.4), rng:NextNumber(1, 1.8), rng:NextNumber(1.2, 2.4))
		newPart("Pebble", small, CFrame.new(position + Vector3.new(math.cos(angle) * size.X * 0.6, small.Y * 0.3, math.sin(angle) * size.Z * 0.6)) * CFrame.Angles(0, angle, math.rad(rng:NextNumber(-20, 20))), color:Lerp(Color3.new(0, 0, 0), 0.08), Enum.Material.Slate, model)
	end
	return model
end

local function buildBush(parent, position, rng)
	local scale = rng:NextNumber(0.7, 1.2)
	for i = 1, 3 do
		local angle = i * (math.pi * 2 / 3) + rng:NextNumber(0, 1)
		local diameter = rng:NextNumber(2, 2.8) * scale
		newBall("Bush", diameter, position + Vector3.new(math.cos(angle) * 0.8 * scale, diameter * 0.35, math.sin(angle) * 0.8 * scale), Color3.fromRGB(60 + rng:NextInteger(0, 30), 165 + rng:NextInteger(0, 30), 80), parent)
	end
end

local FLOWER_COLORS = { Color3.fromRGB(255, 90, 120), Color3.fromRGB(255, 210, 60), Color3.fromRGB(120, 150, 255), Color3.fromRGB(255, 255, 255), Color3.fromRGB(255, 150, 50) }
local function buildFlower(parent, position, rng)
	local stem = newPart("Stem", Vector3.new(0.2, 1.2, 0.2), CFrame.new(position + Vector3.new(0, 0.6, 0)), Color3.fromRGB(70, 160, 70), Enum.Material.SmoothPlastic, parent)
	stem.CanCollide = false
	newEllipsoid("Flower", Vector3.new(0.9, 0.5, 0.9), CFrame.new(position + Vector3.new(0, 1.3, 0)), FLOWER_COLORS[rng:NextInteger(1, #FLOWER_COLORS)], parent)
	newBall("Center", 0.35, position + Vector3.new(0, 1.5, 0), Color3.fromRGB(255, 230, 90), parent)
end

-- Vérifie qu'une position ne gêne pas le jeu (chemins, zones, tapis, spawn, barrière)
local function isFree(position)
	if math.abs(position.X) < 11 then
		return false
	end
	local conveyor = GameConfig.Conveyor
	local toConveyor = position - conveyor.Center
	if math.abs(toConveyor.X) < conveyor.Length / 2 + 14 and math.abs(toConveyor.Z) < conveyor.Width / 2 + 14 then
		return false
	end
	local flat = Vector3.new(position.X, 0, position.Z)
	if (flat - Vector3.new(GameConfig.SpawnPosition.X, 0, GameConfig.SpawnPosition.Z)).Magnitude < 28 then
		return false
	end
	for _, def in ipairs(SlimeConfig.List) do
		if (flat - Vector3.new(def.ZonePosition.X, 0, def.ZonePosition.Z)).Magnitude < def.ZoneRadius + 8 then
			return false
		end
	end
	return true
end

local function buildNature(map)
	local nature = folder("Nature", map)
	local rng = Random.new(42)
	local want = MapConfig.Decor
	local counts = { Trees = 0, Rocks = 0, Bushes = 0, Flowers = 0 }
	local g = MapConfig.Ground
	local margin = MapConfig.Fence.Inset + 6
	local minX, maxX = g.Center.X - g.Size.X / 2 + margin, g.Center.X + g.Size.X / 2 - margin
	local minZ, maxZ = g.Center.Z - g.Size.Z / 2 + margin, g.Center.Z + g.Size.Z / 2 - margin
	local attempts = 0
	while (counts.Trees < want.Trees or counts.Rocks < want.Rocks or counts.Bushes < want.Bushes or counts.Flowers < want.Flowers) and attempts < 5000 do
		attempts = attempts + 1
		local position = Vector3.new(rng:NextNumber(minX, maxX), 0, rng:NextNumber(minZ, maxZ))
		if isFree(position) then
			local roll = rng:NextNumber()
			if counts.Trees < want.Trees and roll < 0.3 then
				buildTree(nature, position, rng)
				counts.Trees = counts.Trees + 1
			elseif counts.Rocks < want.Rocks and roll < 0.42 then
				buildRock(nature, position, rng)
				counts.Rocks = counts.Rocks + 1
			elseif counts.Bushes < want.Bushes and roll < 0.6 then
				buildBush(nature, position, rng)
				counts.Bushes = counts.Bushes + 1
			elseif counts.Flowers < want.Flowers then
				buildFlower(nature, position, rng)
				counts.Flowers = counts.Flowers + 1
			end
		end
	end
end

---------------------------------------------------------------------------
-- Barrière low poly + murs invisibles
---------------------------------------------------------------------------
local function buildFence(map)
	local conf = MapConfig.Fence
	if not conf.Enabled then
		return
	end
	local fence = folder("Fence", map)
	local g = MapConfig.Ground
	local halfX = g.Size.X / 2 - conf.Inset
	local halfZ = g.Size.Z / 2 - conf.Inset
	local cx, cz = g.Center.X, g.Center.Z

	-- Les 4 côtés : { départ, arrivée }
	local corners = {
		Vector3.new(cx - halfX, 0, cz - halfZ),
		Vector3.new(cx + halfX, 0, cz - halfZ),
		Vector3.new(cx + halfX, 0, cz + halfZ),
		Vector3.new(cx - halfX, 0, cz + halfZ),
	}
	for side = 1, 4 do
		local from = corners[side]
		local to = corners[side % 4 + 1]
		local length = (to - from).Magnitude
		local direction = (to - from).Unit
		local mid = (from + to) / 2
		local look = CFrame.lookAt(mid, to)

		-- Poteaux
		local count = math.floor(length / conf.PostSpacing)
		for i = 0, count do
			local position = from + direction * math.min(i * conf.PostSpacing, length)
			local post = newPart("Post", conf.PostSize, CFrame.new(position + Vector3.new(0, conf.PostSize.Y / 2, 0)) * look.Rotation, conf.PostColor, Enum.Material.SmoothPlastic, fence)
			-- Chapeau du poteau
			newPart("PostCap", Vector3.new(conf.PostSize.X + 0.3, 0.3, conf.PostSize.Z + 0.3), CFrame.new(position + Vector3.new(0, conf.PostSize.Y + 0.15, 0)) * look.Rotation, conf.PostColor:Lerp(Color3.new(0, 0, 0), 0.15), Enum.Material.SmoothPlastic, fence)
			post.CanCollide = true
		end
		-- Traverses
		for _, height in ipairs(conf.RailHeights) do
			newPart("Rail", Vector3.new(conf.RailSize.X, conf.RailSize.Y, length), look * CFrame.new(0, height, 0), conf.RailColor, Enum.Material.SmoothPlastic, fence)
		end
		-- Mur invisible (empêche de sortir de la map)
		local wall = newPart("Wall", Vector3.new(1, conf.WallHeight, length + 2), look * CFrame.new(0, conf.WallHeight / 2, 0), Color3.new(1, 1, 1), Enum.Material.SmoothPlastic, fence)
		wall.Transparency = 1
		wall.CanCollide = true
	end
end

---------------------------------------------------------------------------
-- Nuages low poly (déplacés par DecorController côté client)
---------------------------------------------------------------------------
local function buildClouds(map)
	local conf = MapConfig.Clouds
	local clouds = folder("Clouds", map)
	local rng = Random.new(7)
	local g = MapConfig.Ground
	local width = g.Size.X + 160
	for i = 1, conf.Count do
		local model = Instance.new("Model")
		model.Name = "Cloud"
		local scale = rng:NextNumber(0.8, 1.8)
		local puffs = rng:NextInteger(3, 5)
		local baseCFrame = CFrame.new()
		for p = 1, puffs do
			local offset = Vector3.new((p - (puffs + 1) / 2) * 5 * scale + rng:NextNumber(-1, 1), rng:NextNumber(-0.6, 0.8) * scale, rng:NextNumber(-1.5, 1.5) * scale)
			local size = Vector3.new(rng:NextNumber(6, 9) * scale, rng:NextNumber(3, 4.5) * scale, rng:NextNumber(5, 7) * scale)
			local puff = newEllipsoid("Puff", size, baseCFrame * CFrame.new(offset), conf.Color, model)
			puff.CastShadow = false
		end
		local primary = model:FindFirstChild("Puff")
		model.PrimaryPart = primary
		local y = rng:NextNumber(conf.MinHeight, conf.MaxHeight)
		local z = g.Center.Z + rng:NextNumber(-g.Size.Z / 2 - 60, g.Size.Z / 2 + 60)
		model:SetAttribute("Y", y)
		model:SetAttribute("Z", z)
		model:SetAttribute("Phase", rng:NextNumber(0, width))
		model:SetAttribute("Speed", conf.Speed * rng:NextNumber(0.6, 1.4))
		model:SetAttribute("StartX", g.Center.X - width / 2)
		model:SetAttribute("Width", width)
		model:PivotTo(CFrame.new(g.Center.X, y, z))
		model.Parent = clouds
	end
end

---------------------------------------------------------------------------
-- Tapis roulant
---------------------------------------------------------------------------
local function buildConveyor(map)
	local conf = GameConfig.Conveyor
	local model = Instance.new("Model")
	model.Name = "Conveyor"
	model.Parent = map

	local direction = conf.Direction.Unit
	local look = CFrame.lookAt(conf.Center, conf.Center + direction)
	local beltCenter = look * CFrame.new(0, conf.BeltHeight / 2, 0)

	newPart("Belt", Vector3.new(conf.Width, conf.BeltHeight, conf.Length), beltCenter, Color3.fromRGB(25, 25, 28), Enum.Material.SmoothPlastic, model)

	local borderHeight = conf.BeltHeight + 0.7
	for _, side in ipairs({ -1, 1 }) do
		newPart("Border", Vector3.new(1.4, borderHeight, conf.Length + 2.8), look * CFrame.new(side * (conf.Width / 2 + 0.7), borderHeight / 2, 0), Color3.fromRGB(125, 125, 130), Enum.Material.SmoothPlastic, model)
	end
	for _, endSide in ipairs({ -1, 1 }) do
		newPart("End", Vector3.new(conf.Width + 2.8, borderHeight, 1.4), look * CFrame.new(0, borderHeight / 2, endSide * (conf.Length / 2 + 0.7)), Color3.fromRGB(125, 125, 130), Enum.Material.SmoothPlastic, model)
		-- Rouleaux aux extrémités
		-- (l'axe du Cylinder est X = la largeur du tapis : aucune rotation nécessaire)
		local roller = newPart("Roller", Vector3.new(conf.Width + 1, 1.2, 1.2), look * CFrame.new(0, conf.BeltHeight / 2 + 0.3, endSide * (conf.Length / 2 + 1.6)), Color3.fromRGB(90, 90, 96), Enum.Material.Metal, model)
		roller.Shape = Enum.PartType.Cylinder
	end

	local slats = folder("Slats", model)
	local spacing = 3
	local count = math.floor(conf.Length / spacing)
	for i = 0, count - 1 do
		local slat = newPart("Slat", Vector3.new(conf.Width - 1.6, 0.08, 1.2), look * CFrame.new(0, conf.BeltHeight + 0.04, -conf.Length / 2 + i * spacing), Color3.fromRGB(75, 75, 80), Enum.Material.SmoothPlastic, slats)
		slat.CanCollide = false
		slat.CanQuery = false
		slat:SetAttribute("Offset", i * spacing)
	end
end

local function setupLighting()
	Lighting.ClockTime = 14
	Lighting.Brightness = 2.5
	Lighting.Ambient = Color3.fromRGB(120, 120, 120)
	Lighting.OutdoorAmbient = Color3.fromRGB(150, 150, 150)
	Lighting.GlobalShadows = true
end

function MapBuilder.Build()
	if workspace:FindFirstChild("Map") then
		return workspace.Map
	end
	local oldBaseplate = workspace:FindFirstChild("Baseplate")
	if oldBaseplate then
		oldBaseplate:Destroy()
	end
	local oldSpawn = workspace:FindFirstChild("SpawnLocation")
	if oldSpawn then
		oldSpawn:Destroy()
	end

	local map = folder("Map", workspace)
	buildGround(map)
	buildPaths(map)
	buildZones(map)
	buildNature(map)
	buildFence(map)
	buildClouds(map)
	buildConveyor(map)
	buildSpawn(map)
	setupLighting()
	return map
end

return MapBuilder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX16"><Properties><string name="Name">SlimeBuilder</string><ProtectedString name="Source"><![CDATA[--[[
	SlimeBuilder (ModuleScript)
	Emplacement : ServerScriptService > Builders > SlimeBuilder

	Construit le modèle 3D d'un slime d'après sa catégorie (SlimeConfig) et son apparence
	(SlimeConfig.Looks) : corps gélatineux, yeux, sourcils, cristaux, cornes, pointes,
	fissures lumineuses, armure, couronne, particules, lumière, aura, barre de vie.

	Les animations (respiration, clignement, coup reçu, mort) sont jouées par chaque
	client dans SlimeAnimator : le serveur ne touche qu'aux attributs et à la position.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SlimeConfig = require(ReplicatedStorage.Config.SlimeConfig)
local Util = require(ReplicatedStorage.Shared.Util)

local SlimeBuilder = {}

local function newPart(name, size, color, parent)
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.Color = color
	part.Material = Enum.Material.SmoothPlastic
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

function SlimeBuilder.GetBodySize(def)
	return Vector3.new(def.Size, def.Size * 0.75, def.Size)
end

-- Particules par type
local PARTICLE_PRESETS = {
	Frost = { Colors = { Color3.fromRGB(190, 235, 255), Color3.fromRGB(255, 255, 255) }, Size = 0.12, Speed = NumberRange.new(0.5, 1.5), Lifetime = NumberRange.new(1, 2), Rate = 2, Transparency = 0.2, LightEmission = 0.8, Spread = 180, Acceleration = Vector3.new(0, 0.5, 0) },
	Shadow = { Colors = { Color3.fromRGB(90, 0, 130), Color3.fromRGB(20, 0, 30) }, Size = 0.3, Speed = NumberRange.new(0.5, 1.2), Lifetime = NumberRange.new(1, 1.8), Rate = 2.5, Transparency = 0.4, LightEmission = 0, Spread = 180, Acceleration = Vector3.new(0, 0.8, 0) },
	Fire = { Colors = { Color3.fromRGB(255, 210, 70), Color3.fromRGB(255, 60, 0) }, Size = 0.22, Speed = NumberRange.new(2, 4), Lifetime = NumberRange.new(0.5, 0.9), Rate = 4, Transparency = 0.1, LightEmission = 1, Spread = 35, Acceleration = Vector3.new(0, 3, 0) },
	Embers = { Colors = { Color3.fromRGB(255, 130, 60), Color3.fromRGB(255, 40, 40) }, Size = 0.08, Speed = NumberRange.new(3, 6), Lifetime = NumberRange.new(0.8, 1.4), Rate = 5, Transparency = 0, LightEmission = 1, Spread = 60, Acceleration = Vector3.new(0, 2, 0) },
}

function SlimeBuilder.Build(def)
	local size = def.Size
	local look = SlimeConfig.GetLook(def.Id)
	local model = Instance.new("Model")
	model.Name = def.Name

	-- Corps gélatineux : enveloppe translucide + cœur plus foncé
	local body = newPart("Body", SlimeBuilder.GetBodySize(def), def.Color, model)
	body.CanQuery = true
	body.Transparency = 0.22
	body.Reflectance = 0.04
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = body
	body:SetAttribute("BaseSize", body.Size)
	model.PrimaryPart = body

	local radiusX, radiusY = size / 2, size * 0.375

	-- Point sur la surface du corps (angle autour, élévation en radians)
	local function surface(angle, elevation, factor)
		factor = factor or 1
		return Vector3.new(math.cos(elevation) * math.cos(angle) * radiusX, math.sin(elevation) * radiusY, math.cos(elevation) * math.sin(angle) * radiusX) * factor
	end

	local function ellipsoid(name, partSize, color, offset)
		local part = newPart(name, partSize, color, model)
		part.CFrame = body.CFrame * CFrame.new(offset)
		local partMesh = Instance.new("SpecialMesh")
		partMesh.MeshType = Enum.MeshType.Sphere
		partMesh.Parent = part
		return part
	end

	-- Bloc allongé planté sur le corps, pointant dans une direction (cristaux, cornes, pointes)
	local function shard(name, base, direction, length, width, color, material)
		local dir = direction.Unit
		local part = newPart(name, Vector3.new(width, length, width), color, model)
		part.Material = material or Enum.Material.SmoothPlastic
		part.CFrame = body.CFrame * (CFrame.lookAt(base + dir * length / 2, base + dir * length) * CFrame.Angles(-math.pi / 2, 0, 0))
		return part
	end

	-- Plaque posée à plat sur la surface (fissures, armure)
	local function plate(name, point, partSize, color, material, spin)
		local part = newPart(name, partSize, color, model)
		part.Material = material or Enum.Material.SmoothPlastic
		part.CFrame = body.CFrame * (CFrame.lookAt(point, point * 2) * CFrame.Angles(0, 0, spin or 0))
		return part
	end

	local rng = Random.new(def.Index * 31)

	-- Cœur et reflet
	local core = ellipsoid("Core", SlimeBuilder.GetBodySize(def) * 0.6, def.Color:Lerp(Color3.new(0, 0, 0), 0.35), Vector3.new(0, -size * 0.04, 0))
	core.Transparency = 0.05
	local highlight = ellipsoid("Highlight", Vector3.new(size * 0.2, size * 0.08, size * 0.14), Color3.new(1, 1, 1), Vector3.new(-size * 0.2, size * 0.24, -size * 0.3))
	highlight.Transparency = 0.3
	highlight.CFrame = highlight.CFrame * CFrame.Angles(math.rad(-30), math.rad(20), math.rad(-25))

	-- Yeux
	local function eye(x, y, z, scale)
		local sclera = ellipsoid("Eye", Vector3.new(size * 0.2, size * 0.24, size * 0.2) * scale, Color3.new(1, 1, 1), Vector3.new(x, y, z))
		local pupil = newPart("Pupil", Vector3.new(size * 0.11, size * 0.11, size * 0.11) * scale, def.EyeColor, model)
		pupil.Shape = Enum.PartType.Ball
		if look.EyeGlow then
			pupil.Material = Enum.Material.Neon
		end
		pupil.CFrame = sclera.CFrame * CFrame.new(0, -size * 0.01 * scale, -size * 0.07 * scale)
		local shine = newPart("Shine", Vector3.new(size * 0.045, size * 0.045, size * 0.045) * scale, Color3.new(1, 1, 1), model)
		shine.Shape = Enum.PartType.Ball
		shine.CFrame = pupil.CFrame * CFrame.new(size * 0.03 * scale, size * 0.035 * scale, -size * 0.04 * scale)
	end
	local eyeCount = look.Eyes or 2
	for _, side in ipairs({ -1, 1 }) do
		eye(side * size * 0.18, size * 0.14, -size * 0.4, 1)
	end
	if eyeCount >= 3 then
		eye(0, size * 0.3, -size * 0.33, 0.7)
	end
	if eyeCount >= 4 then
		for _, side in ipairs({ -1, 1 }) do
			eye(side * size * 0.33, size * 0.27, -size * 0.3, 0.65)
		end
	end

	-- Sourcils en colère
	if look.Brows then
		for _, side in ipairs({ -1, 1 }) do
			local brow = newPart("Brow", Vector3.new(size * 0.2, size * 0.045, size * 0.04), Color3.fromRGB(30, 15, 25), model)
			brow.CFrame = body.CFrame * CFrame.new(side * size * 0.18, size * 0.3, -size * 0.41) * CFrame.Angles(0, 0, side * math.rad(25))
		end
	end

	-- Bouche
	local mouth = newPart("Mouth", Vector3.new(size * 0.2, size * 0.04, size * 0.05), Color3.fromRGB(60, 20, 35), model)
	mouth.CFrame = body.CFrame * CFrame.new(0, -size * 0.03, -size * 0.49)
	if look.Brows then
		-- Bouche en colère : deux crocs
		for _, side in ipairs({ -1, 1 }) do
			local fang = newPart("Fang", Vector3.new(size * 0.035, size * 0.06, size * 0.03), Color3.new(1, 1, 1), model)
			fang.CFrame = body.CFrame * CFrame.new(side * size * 0.06, -size * 0.07, -size * 0.49)
		end
	end

	-- Joues roses
	if look.Blush then
		for _, side in ipairs({ -1, 1 }) do
			local blush = ellipsoid("Blush", Vector3.new(size * 0.14, size * 0.07, size * 0.06), Color3.fromRGB(255, 150, 170), Vector3.new(side * size * 0.32, 0, -size * 0.36))
			blush.Transparency = 0.3
		end
	end

	-- Pousse sur la tête
	if look.Leaf then
		local stem = newPart("Stem", Vector3.new(size * 0.05, size * 0.2, size * 0.05), Color3.fromRGB(60, 150, 60), model)
		stem.CFrame = body.CFrame * CFrame.new(0, size * 0.44, 0)
		for _, side in ipairs({ -1, 1 }) do
			local leaf = ellipsoid("Leaf", Vector3.new(size * 0.3, size * 0.06, size * 0.14), Color3.fromRGB(90, 200, 90), Vector3.new(side * size * 0.14, size * 0.53, 0))
			leaf.CFrame = leaf.CFrame * CFrame.Angles(0, 0, side * math.rad(20))
		end
	end

	-- Taches
	for _ = 1, look.Spots or 0 do
		local point = surface(rng:NextNumber(0, math.pi * 2), rng:NextNumber(-0.2, 0.7), 0.97)
		local spot = newPart("Spot", Vector3.new(size * 0.14, size * 0.14, size * 0.14), def.Color:Lerp(Color3.new(0, 0, 0), 0.25), model)
		spot.Shape = Enum.PartType.Ball
		spot.CFrame = body.CFrame * CFrame.new(point)
	end

	-- Cristaux de glace
	for i = 1, look.Crystals or 0 do
		local angle = i * (math.pi * 2 / (look.Crystals or 1)) + 0.3
		local base = surface(angle, rng:NextNumber(0.35, 0.75), 0.9)
		shard("Crystal", base, base + Vector3.new(0, size * 0.2, 0), rng:NextNumber(0.3, 0.5) * size, size * 0.1, look.CrystalColor or Color3.fromRGB(185, 235, 255), Enum.Material.Neon)
	end
	if (look.Crystals or 0) > 0 then
		shard("Crystal", Vector3.new(0, radiusY * 0.9, 0), Vector3.new(0.1, 1, 0), size * 0.55, size * 0.14, look.CrystalColor or Color3.fromRGB(185, 235, 255), Enum.Material.Neon)
	end

	-- Cornes
	if look.Horns then
		for _, side in ipairs({ -1, 1 }) do
			local base = Vector3.new(side * size * 0.2, size * 0.32, -size * 0.05)
			local dir = Vector3.new(side * 0.45, 1, -0.15)
			shard("Horn", base, dir, size * 0.38, size * 0.13, Color3.fromRGB(35, 15, 45))
			shard("Horn", base + dir.Unit * size * 0.34, dir + Vector3.new(side * 0.3, 0, 0), size * 0.2, size * 0.07, Color3.fromRGB(35, 15, 45))
		end
	end

	-- Pointes
	for i = 1, look.Spikes or 0 do
		local angle = i * (math.pi * 2 / (look.Spikes or 1))
		if math.abs(math.sin(angle)) > 0.35 or math.cos(angle) < 0 then -- pas devant les yeux
			local base = surface(angle, rng:NextNumber(0.05, 0.4), 0.92)
			shard("Spike", base, base + Vector3.new(0, size * 0.15, 0), size * 0.3, size * 0.1, Color3.fromRGB(45, 20, 25))
		end
	end

	-- Fissures lumineuses
	for _ = 1, look.Cracks or 0 do
		local angle = rng:NextNumber(0, math.pi * 2)
		local point = surface(angle, rng:NextNumber(-0.3, 0.6), 0.995)
		if math.abs(math.sin(angle)) > 0.3 or math.cos(angle) < 0 then
			plate("Crack", point, Vector3.new(size * 0.05, size * 0.28, size * 0.02), look.CrackColor or Color3.fromRGB(255, 120, 20), Enum.Material.Neon, rng:NextNumber(0, math.pi))
		end
	end

	-- Armure dorée
	if look.Armor then
		for i = 1, 4 do
			local angle = math.rad(45 + (i - 1) * 90)
			local point = surface(angle, 0.15, 1.0)
			plate("Armor", point, Vector3.new(size * 0.34, size * 0.26, size * 0.06), Color3.fromRGB(230, 180, 50), Enum.Material.Metal, 0)
			local rivet = newPart("Rivet", Vector3.new(size * 0.05, size * 0.05, size * 0.05), Color3.fromRGB(120, 80, 20), model)
			rivet.Shape = Enum.PartType.Ball
			rivet.CFrame = body.CFrame * CFrame.new(surface(angle, 0.15, 1.03))
		end
	end

	-- Gouttes
	for i = 1, 3 do
		local angle = i * (math.pi * 2 / 3) + 0.4
		local drop = ellipsoid("Drop", Vector3.new(size * 0.16, size * 0.12, size * 0.16), def.Color, Vector3.new(math.cos(angle) * size * 0.42, -size * 0.3, math.sin(angle) * size * 0.42))
		drop.Transparency = 0.2
	end

	-- Couronne
	if look.Crown then
		local crownY = radiusY + size * 0.02
		local base = newPart("Crown", Vector3.new(size * 0.06, size * 0.42, size * 0.42), Color3.fromRGB(255, 200, 40), model)
		base.Shape = Enum.PartType.Cylinder
		base.Material = Enum.Material.Metal
		base.CFrame = body.CFrame * CFrame.new(0, crownY, 0) * CFrame.Angles(0, 0, math.rad(90))
		for i = 1, 5 do
			local angle = i * (math.pi * 2 / 5)
			local spike = newPart("CrownSpike", Vector3.new(size * 0.09, size * 0.16, size * 0.09), Color3.fromRGB(255, 220, 60), model)
			spike.Material = Enum.Material.Neon
			spike.CFrame = body.CFrame * CFrame.new(math.cos(angle) * size * 0.17, crownY + size * 0.1, math.sin(angle) * size * 0.17)
		end
		local gem = newPart("Gem", Vector3.new(size * 0.1, size * 0.1, size * 0.1), Color3.fromRGB(255, 60, 90), model)
		gem.Shape = Enum.PartType.Ball
		gem.Material = Enum.Material.Neon
		gem.CFrame = body.CFrame * CFrame.new(0, crownY + size * 0.05, -size * 0.2)
	end

	-- Particules
	local preset = look.Particles and PARTICLE_PRESETS[look.Particles]
	if preset then
		local emitter = Instance.new("ParticleEmitter")
		emitter.Name = "Particles"
		emitter.Color = ColorSequence.new(preset.Colors[1], preset.Colors[2])
		emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, preset.Size * size), NumberSequenceKeypoint.new(1, 0) })
		emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, preset.Transparency), NumberSequenceKeypoint.new(1, 1) })
		emitter.Speed = preset.Speed
		emitter.Lifetime = preset.Lifetime
		emitter.Rate = preset.Rate * size
		emitter.LightEmission = preset.LightEmission
		emitter.SpreadAngle = Vector2.new(preset.Spread, preset.Spread)
		emitter.Acceleration = preset.Acceleration
		emitter.Parent = body
	end

	-- Lumière
	if look.Light then
		local light = Instance.new("PointLight")
		light.Color = look.Light
		light.Range = size * 1.8
		light.Brightness = 1.2
		light.Parent = body
	end

	-- Aura
	if look.Aura then
		local aura = ellipsoid("Aura", SlimeBuilder.GetBodySize(def) * 1.18, look.Aura, Vector3.new(0, 0, 0))
		aura.Material = Enum.Material.Neon
		aura.Transparency = 0.86
	end

	-- Nom + barre de vie
	local gui = Instance.new("BillboardGui")
	gui.Name = "Info"
	gui.Adornee = body
	gui.Size = UDim2.fromOffset(190, 60)
	gui.StudsOffsetWorldSpace = Vector3.new(0, radiusY + (look.Crown and size * 0.3 or 0) + (look.Crystals and size * 0.5 or 0) + 2.5, 0)
	gui.MaxDistance = 150
	gui.LightInfluence = 0
	gui.Parent = body

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Name = "NameLabel"
	nameLabel.BackgroundTransparency = 1
	nameLabel.Size = UDim2.new(1, 0, 0, 30)
	nameLabel.Font = Enum.Font.FredokaOne
	nameLabel.Text = def.Name
	nameLabel.TextColor3 = def.Index >= 5 and Color3.fromRGB(255, 120, 90) or Color3.new(1, 1, 1)
	nameLabel.TextSize = 24
	nameLabel.Parent = gui
	local nameStroke = Instance.new("UIStroke")
	nameStroke.Thickness = 2.5
	nameStroke.Color = Color3.new(0, 0, 0)
	nameStroke.Parent = nameLabel

	local barBackground = Instance.new("Frame")
	barBackground.Name = "Bar"
	barBackground.Size = UDim2.new(1, -20, 0, 20)
	barBackground.Position = UDim2.fromOffset(10, 34)
	barBackground.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
	barBackground.BorderSizePixel = 0
	barBackground.Parent = gui
	local barCorner = Instance.new("UICorner")
	barCorner.CornerRadius = UDim.new(0, 8)
	barCorner.Parent = barBackground
	local barStroke = Instance.new("UIStroke")
	barStroke.Thickness = 2
	barStroke.Color = Color3.new(0, 0, 0)
	barStroke.Parent = barBackground

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = Color3.fromRGB(90, 230, 90)
	fill.BorderSizePixel = 0
	fill.Parent = barBackground
	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(0, 8)
	fillCorner.Parent = fill

	local hpLabel = Instance.new("TextLabel")
	hpLabel.Name = "HpLabel"
	hpLabel.BackgroundTransparency = 1
	hpLabel.Size = UDim2.fromScale(1, 1)
	hpLabel.Font = Enum.Font.FredokaOne
	hpLabel.Text = Util.FormatNumber(def.Health) .. " / " .. Util.FormatNumber(def.Health)
	hpLabel.TextColor3 = Color3.new(1, 1, 1)
	hpLabel.TextSize = 15
	hpLabel.Parent = barBackground
	local hpStroke = Instance.new("UIStroke")
	hpStroke.Thickness = 1.5
	hpStroke.Color = Color3.new(0, 0, 0)
	hpStroke.Parent = hpLabel

	model:SetAttribute("SlimeId", def.Id)
	model:SetAttribute("MaxHealth", def.Health)
	model:SetAttribute("Health", def.Health)
	model:SetAttribute("Alive", true)
	return model
end

function SlimeBuilder.UpdateHealth(model, health, maxHealth)
	local body = model.PrimaryPart
	local gui = body and body:FindFirstChild("Info")
	if not gui then
		return
	end
	local ratio = math.clamp(health / maxHealth, 0, 1)
	local bar = gui.Bar
	bar.Fill.Size = UDim2.fromScale(ratio, 1)
	bar.Fill.BackgroundColor3 = Color3.fromRGB(230, 60, 60):Lerp(Color3.fromRGB(90, 230, 90), ratio)
	bar.HpLabel.Text = Util.FormatNumber(math.max(0, health)) .. " / " .. Util.FormatNumber(maxHealth)
end

-- Mort : cache la barre de vie puis attend la fin de l'animation jouée par les clients
function SlimeBuilder.PlayDeath(model)
	local info = model:FindFirstChild("Info", true)
	if info then
		info.Enabled = false
	end
	local emitter = model:FindFirstChild("Particles", true)
	if emitter then
		emitter.Enabled = false
	end
	task.wait(0.5)
end

return SlimeBuilder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX17"><Properties><string name="Name">SwordBuilder</string><ProtectedString name="Source"><![CDATA[--[[
	SwordBuilder (ModuleScript)
	Emplacement : ServerScriptService > Builders > SwordBuilder

	Construit l'épée (modèle "Sword" dans le personnage) et la soude à la main droite.
	L'épée est toujours tenue : pas de Tool ni de barre d'outils à gérer.
	La traînée (Trail) est créée ici ; sa couleur dépend de l'effet équipé.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SwordConfig = require(ReplicatedStorage.Config.SwordConfig)
local EffectConfig = require(ReplicatedStorage.Config.EffectConfig)

local SwordBuilder = {}

local function newPart(name, size, color, material, parent)
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.Color = color
	part.Material = material
	part.Anchored = false
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.CastShadow = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

local function getHand(character)
	return character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
end

function SwordBuilder.Attach(character, swordId, effectId)
	local def = SwordConfig.Get(swordId) or SwordConfig.Get(SwordConfig.DefaultSword)
	local hand = getHand(character)
	if not hand then
		return nil
	end

	local old = character:FindFirstChild("Sword")
	if old then
		old:Destroy()
	end

	local style = def.Style
	local model = Instance.new("Model")
	model.Name = "Sword"

	-- Point de prise : la lame pointe vers l'avant de la main
	local gripOffset
	if hand.Name == "RightHand" then
		gripOffset = CFrame.new(0, -0.15, 0)
	else
		gripOffset = CFrame.new(0, -1, 0) -- R6
	end
	gripOffset = gripOffset * CFrame.Angles(-math.pi / 2, 0, 0)
	local handleCFrame = hand.CFrame * gripOffset

	local handle = newPart("Handle", Vector3.new(0.3, 1.1, 0.3), style.GripColor, Enum.Material.SmoothPlastic, model)
	handle.CFrame = handleCFrame

	local pommel = newPart("Pommel", Vector3.new(0.45, 0.3, 0.45), style.GuardColor, Enum.Material.Metal, model)
	pommel.CFrame = handleCFrame * CFrame.new(0, -0.7, 0)

	local guard = newPart("Guard", Vector3.new(1.3, 0.22, 0.42), style.GuardColor, Enum.Material.Metal, model)
	guard.CFrame = handleCFrame * CFrame.new(0, 0.65, 0)

	local blade = newPart("Blade", Vector3.new(0.18, style.Length, 0.6), style.BladeColor, style.Material, model)
	blade.CFrame = handleCFrame * CFrame.new(0, 0.76 + style.Length / 2, 0)

	local tip = Instance.new("WedgePart")
	tip.Name = "Tip"
	tip.Size = Vector3.new(0.18, 0.6, 0.6)
	tip.Color = style.BladeColor
	tip.Material = style.Material
	tip.Anchored = false
	tip.CanCollide = false
	tip.CanQuery = false
	tip.CanTouch = false
	tip.Massless = true
	tip.CastShadow = false
	-- Pointe biseautée posée sur le haut de la lame
	tip.CFrame = handleCFrame * CFrame.new(0, 0.76 + style.Length + 0.3, 0)
	tip.Parent = model

	-- Traînée lumineuse (activée pendant les coups par le client)
	local top = Instance.new("Attachment")
	top.Name = "TrailTop"
	top.Position = Vector3.new(0, style.Length / 2 + 0.5, 0)
	top.Parent = blade
	local bottom = Instance.new("Attachment")
	bottom.Name = "TrailBottom"
	bottom.Position = Vector3.new(0, -style.Length / 2 + 0.2, 0)
	bottom.Parent = blade

	local trail = Instance.new("Trail")
	trail.Name = "Trail"
	trail.Attachment0 = top
	trail.Attachment1 = bottom
	trail.Enabled = false
	trail.Lifetime = 0.2
	trail.MinLength = 0
	trail.FaceCamera = true
	trail.LightEmission = 0.8
	trail.LightInfluence = 0
	trail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
	trail.WidthScale = NumberSequence.new(1)
	trail.Parent = blade

	if style.Glow then
		local light = Instance.new("PointLight")
		light.Color = style.Glow
		light.Range = 7
		light.Brightness = 1.2
		light.Parent = blade
	end

	-- Soudures : tout est attaché au manche, le manche est attaché à la main
	for _, part in ipairs(model:GetChildren()) do
		if part ~= handle and part:IsA("BasePart") then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = handle
			weld.Part1 = part
			weld.Parent = part
		end
	end
	local grip = Instance.new("Weld")
	grip.Name = "Grip"
	grip.Part0 = hand
	grip.Part1 = handle
	grip.C0 = gripOffset
	grip.Parent = handle

	model.PrimaryPart = handle
	model:SetAttribute("SwordId", def.Id)
	model.Parent = character

	SwordBuilder.ApplyEffect(character, effectId)
	return model
end

-- Applique la couleur de traînée de l'effet équipé (ou blanc par défaut)
function SwordBuilder.ApplyEffect(character, effectId)
	local sword = character:FindFirstChild("Sword")
	local blade = sword and sword:FindFirstChild("Blade")
	local trail = blade and blade:FindFirstChild("Trail")
	if not trail then
		return
	end
	local effect = EffectConfig.Get(effectId)
	if effect then
		trail.Color = effect.TrailColor
		trail.LightEmission = 1
	else
		trail.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255))
		trail.LightEmission = 0.6
	end
	sword:SetAttribute("Effect", effect and effect.Id or "")
end

return SwordBuilder
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX28"><Properties><string name="Name">Services</string></Properties><Item class="ModuleScript" referent="RBX19"><Properties><string name="Name">CombatService</string><ProtectedString name="Source"><![CDATA[--[[
	CombatService (ModuleScript)
	Emplacement : ServerScriptService > Services > CombatService

	Reçoit les attaques du joueur (RemoteEvent "Attack") et fait attaquer les œufs
	équipés automatiquement. Le SERVEUR calcule les dégâts, vérifie la cadence,
	la portée et la cible : le client n'envoie que "je frappe ce slime".
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local GameConfig = require(ReplicatedStorage.Config.GameConfig)
local SwordConfig = require(ReplicatedStorage.Config.SwordConfig)
local CombatMath = require(ReplicatedStorage.Shared.CombatMath)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local DataService = require(ServerScriptService.Services.DataService)
local SlimeService = require(ServerScriptService.Services.SlimeService)

local CombatService = {}

local Attack = Remotes.Get("Attack")
local AttackVFX = Remotes.Get("AttackVFX")
local CompanionAttack = Remotes.Get("CompanionAttack")

local lastAttack = {} -- [player] = os.clock() du dernier coup accepté
local lastTarget = {} -- [player] = state du dernier slime frappé
local combatUntil = {} -- [player] = heure jusqu'à laquelle les œufs attaquent
local eggTimers = {} -- [player] = { [eggId] = prochaine attaque }

local function getRoot(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end
	return character:FindFirstChild("HumanoidRootPart")
end

local function onAttack(player, slimeModel)
	local profile = DataService.Get(player)
	if not profile then
		return
	end
	if typeof(slimeModel) ~= "Instance" then
		return
	end
	local state = SlimeService.GetState(slimeModel)
	if not state or not state.Alive then
		return
	end
	local root = getRoot(player)
	if not root then
		return
	end

	-- Cadence (avec une tolérance pour la latence)
	local damage, interval, tierIndex = CombatMath.GetSwordAttack(profile)
	local now = os.clock()
	if now - (lastAttack[player] or 0) < interval * GameConfig.Combat.CooldownTolerance then
		return
	end

	-- Portée
	local sword = SwordConfig.Get(profile.EquippedSword) or SwordConfig.Get(SwordConfig.DefaultSword)
	local slimePosition = slimeModel:GetPivot().Position
	local distance = (root.Position - slimePosition).Magnitude
	if distance > sword.Range + state.Def.Size / 2 + GameConfig.Combat.DistanceTolerance then
		return
	end

	lastAttack[player] = now
	combatUntil[player] = now + GameConfig.Combat.CombatTimeout
	lastTarget[player] = state

	SlimeService.ApplyDamage(state, player, damage)
	AttackVFX:FireAllClients(player, slimeModel, slimePosition, damage, tierIndex, profile.EquippedEffect or "")
end

-- Attaques automatiques des œufs équipés (pendant le combat seulement)
local function companionStep()
	local now = os.clock()
	for _, player in ipairs(Players:GetPlayers()) do
		if (combatUntil[player] or 0) > now then
			local profile = DataService.Get(player)
			local root = profile and getRoot(player)
			if root then
				local timers = eggTimers[player]
				if not timers then
					timers = {}
					eggTimers[player] = timers
				end
				local range = GameConfig.Combat.CompanionRange
				for slot, eggId in ipairs(profile.Equipped) do
					if (timers[eggId] or 0) <= now then
						local item = CombatMath.FindEgg(profile, eggId)
						if item then
							local damage, interval = CombatMath.GetEggAttack(item)
							local target = lastTarget[player]
							if not (target and target.Alive and target.Model.Parent and (target.Model:GetPivot().Position - root.Position).Magnitude <= range) then
								target = SlimeService.GetNearest(root.Position, range)
							end
							if target then
								timers[eggId] = now + interval
								local position = target.Model:GetPivot().Position
								local targetModel = target.Model
								SlimeService.ApplyDamage(target, player, damage)
								CompanionAttack:FireAllClients(player.UserId, slot, targetModel, position, damage)
							else
								timers[eggId] = now + 0.25 -- réessaie bientôt
							end
						end
					end
				end
			end
		end
	end
end

function CombatService.Init()
	Attack.OnServerEvent:Connect(onAttack)
	RunService.Heartbeat:Connect(companionStep)
	Players.PlayerRemoving:Connect(function(player)
		lastAttack[player] = nil
		lastTarget[player] = nil
		combatUntil[player] = nil
		eggTimers[player] = nil
	end)
end

return CombatService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX20"><Properties><string name="Name">CompanionService</string><ProtectedString name="Source"><![CDATA[--[[
	CompanionService (ModuleScript)
	Emplacement : ServerScriptService > Services > CompanionService

	Crée les modèles 3D des œufs équipés dans Workspace > Companions > <NomDuJoueur>.
	Le mouvement (suivi fluide + flottement) est calculé par chaque client
	(CompanionController) : le serveur ne fait que créer / supprimer les modèles.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local GameConfig = require(ReplicatedStorage.Config.GameConfig)
local EggBuilder = require(ReplicatedStorage.Shared.EggBuilder)
local CombatMath = require(ReplicatedStorage.Shared.CombatMath)
local DataService = require(ServerScriptService.Services.DataService)

local CompanionService = {}

local root = workspace:WaitForChild("Companions")

local function getFolder(player)
	local folder = root:FindFirstChild(player.Name)
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = player.Name
		folder.Parent = root
	end
	return folder
end

-- Reconstruit les compagnons d'après la liste des œufs équipés
function CompanionService.Refresh(player)
	local profile = DataService.Get(player)
	if not profile then
		return
	end
	local folder = getFolder(player)
	folder:ClearAllChildren()

	local character = player.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	local baseCFrame = hrp and hrp.CFrame or CFrame.new(GameConfig.SpawnPosition)

	for slot, eggId in ipairs(profile.Equipped) do
		local item = CombatMath.FindEgg(profile, eggId)
		if item then
			local model = EggBuilder.Build(item.Rarity, item.Variant, GameConfig.Companion.Scale)
			model.Name = "Companion_" .. eggId
			model:SetAttribute("Owner", player.UserId)
			model:SetAttribute("Slot", slot)
			model:SetAttribute("EggId", eggId)
			local offset = GameConfig.Companion.Offsets[slot] or GameConfig.Companion.Offsets[#GameConfig.Companion.Offsets]
			model:PivotTo(baseCFrame * CFrame.new(offset))
			model.Parent = folder
		end
	end
end

function CompanionService.Remove(player)
	local folder = root:FindFirstChild(player.Name)
	if folder then
		folder:Destroy()
	end
end

return CompanionService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX21"><Properties><string name="Name">ConveyorService</string><ProtectedString name="Source"><![CDATA[--[[
	ConveyorService (ModuleScript)
	Emplacement : ServerScriptService > Services > ConveyorService

	Fait apparaître les œufs à une extrémité du tapis et les détruit à l'autre.
	Le déplacement visuel est calculé par chaque client d'après l'heure d'apparition
	(attribut SpawnTime) : c'est fluide et le serveur retrouve la position exacte
	au moment de l'achat pour vérifier la distance.

	Achat : ProximityPrompt (touche E sur PC, bouton tactile sur mobile).
	Un œuf ne peut être acheté qu'une seule fois, même si deux joueurs appuient en même temps.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local GameConfig = require(ReplicatedStorage.Config.GameConfig)
local EggConfig = require(ReplicatedStorage.Config.EggConfig)
local EggBuilder = require(ReplicatedStorage.Shared.EggBuilder)
local Util = require(ReplicatedStorage.Shared.Util)

local DataService = require(ServerScriptService.Services.DataService)
local PlayerService = require(ServerScriptService.Services.PlayerService)
local InventoryService = require(ServerScriptService.Services.InventoryService)

local ConveyorService = {}

local conf = GameConfig.Conveyor
local eggsFolder = workspace:WaitForChild("ConveyorEggs")
local random = Random.new()

local direction = conf.Direction.Unit
local travelLength = conf.Length - 4
local travelTime = travelLength / conf.Speed

local function startPosition()
	local eggHeight = EggBuilder.GetHeight(conf.EggScale)
	return conf.Center - direction * (travelLength / 2) + Vector3.new(0, conf.BeltHeight + eggHeight / 2, 0)
end

-- Position actuelle d'un œuf (même formule que le client)
function ConveyorService.GetEggPosition(model)
	local spawnTime = model:GetAttribute("SpawnTime") or 0
	local start = model:GetAttribute("StartPosition") or startPosition()
	local elapsed = workspace:GetServerTimeNow() - spawnTime
	return start + direction * conf.Speed * elapsed
end

local function tryBuy(player, model)
	if not model.Parent then
		return
	end
	-- Réservation immédiate : le premier arrivé gagne
	if model:GetAttribute("Sold") then
		PlayerService.Notify(player, "Trop tard, cet œuf vient d'être acheté !", Color3.fromRGB(255, 120, 120))
		return
	end
	model:SetAttribute("Sold", true)

	local function refuse(message)
		model:SetAttribute("Sold", false)
		PlayerService.Notify(player, message, Color3.fromRGB(255, 120, 120))
	end

	local profile = DataService.Get(player)
	if not profile then
		return refuse("Profil non chargé")
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return refuse("Personnage introuvable")
	end
	local distance = (root.Position - ConveyorService.GetEggPosition(model)).Magnitude
	if distance > conf.BuyDistance + GameConfig.Combat.DistanceTolerance then
		return refuse("Trop loin de l'œuf")
	end
	local price = model:GetAttribute("Price") or 0
	if not PlayerService.SpendCash(player, price) then
		return refuse("Pas assez d'argent (" .. Util.FormatNumber(price) .. " $)")
	end

	local rarityId = model:GetAttribute("Rarity")
	local variantId = model:GetAttribute("Variant")
	model:Destroy()
	InventoryService.AddEgg(player, rarityId, variantId)
	PlayerService.Notify(player, "🥚 " .. EggConfig.GetDisplayName(rarityId, variantId) .. " acheté !", Color3.fromRGB(120, 255, 120))
end

local function spawnEgg()
	local rarity = EggConfig.RollRarity(random)
	local variant = EggConfig.RollVariant(random)
	local price = EggConfig.GetPrice(rarity.Id, variant.Id)

	local model = EggBuilder.Build(rarity.Id, variant.Id, conf.EggScale)
	model.Name = "ConveyorEgg"
	local start = startPosition()
	model:SetAttribute("Price", price)
	model:SetAttribute("SpawnTime", workspace:GetServerTimeNow())
	model:SetAttribute("StartPosition", start)
	model:SetAttribute("Sold", false)
	model:PivotTo(CFrame.new(start))

	EggBuilder.AddLabel(model, rarity.Id, variant.Id, price)

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Acheter"
	prompt.ObjectText = EggConfig.GetDisplayName(rarity.Id, variant.Id) .. "  •  " .. Util.FormatNumber(price) .. " $"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = conf.BuyDistance
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.UIOffset = Vector2.new(0, 40)
	prompt.Parent = model.PrimaryPart
	prompt.Triggered:Connect(function(player)
		tryBuy(player, model)
	end)

	model.Parent = eggsFolder

	-- Disparition au bout du tapis
	task.delay(travelTime, function()
		if model.Parent then
			model:Destroy()
		end
	end)
end

function ConveyorService.Init()
	task.spawn(function()
		task.wait(2)
		while true do
			if #eggsFolder:GetChildren() < conf.MaxEggs then
				spawnEgg()
			end
			task.wait(conf.SpawnInterval)
		end
	end)
end

return ConveyorService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX22"><Properties><string name="Name">DataService</string><ProtectedString name="Source"><![CDATA[--[[
	DataService (ModuleScript)
	Emplacement : ServerScriptService > Services > DataService

	Chargement / sauvegarde des profils avec DataStoreService.
	- Si le chargement échoue, le joueur joue avec un profil vide MAIS la sauvegarde
	  est désactivée pour la session (pour ne jamais écraser une vraie sauvegarde).
	- Sauvegarde automatique, à la déconnexion et à la fermeture du serveur.

	Dans Studio : Game Settings > Security > "Enable Studio Access to API Services"
	doit être coché pour que les DataStores fonctionnent en test.
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Config.GameConfig)
local SwordConfig = require(ReplicatedStorage.Config.SwordConfig)
local Util = require(ReplicatedStorage.Shared.Util)

local DataService = {}

local store = nil
local sessions = {} -- [player] = { Data = table, Loaded = boolean }

-- Profil d'un nouveau joueur
local function defaultProfile()
	return {
		Cash = GameConfig.StartCash,
		TotalEarned = 0, -- argent total gagné en combat (sert pour les rangs)
		Kills = 0,
		Eggs = {}, -- { {Id = "e1", Rarity = "Common", Variant = "Normal"}, ... }
		NextEggId = 1,
		Equipped = {}, -- identifiants des œufs équipés
		Swords = { SwordConfig.DefaultSword },
		EquippedSword = SwordConfig.DefaultSword,
		Effects = {},
		EquippedEffect = "",
		Discovered = {}, -- ["Common_Normal"] = true
	}
end

local function keyFor(player)
	return "player_" .. player.UserId
end

function DataService.Init()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(GameConfig.Data.StoreName)
	end)
	if ok then
		store = result
	else
		warn("[DataService] DataStore indisponible : " .. tostring(result))
	end

	Players.PlayerRemoving:Connect(function(player)
		DataService.Save(player)
		sessions[player] = nil
	end)

	game:BindToClose(function()
		local remaining = 0
		for player in pairs(sessions) do
			remaining = remaining + 1
			task.spawn(function()
				DataService.Save(player)
				remaining = remaining - 1
			end)
		end
		local start = os.clock()
		while remaining > 0 and os.clock() - start < 25 do
			task.wait(0.1)
		end
	end)

	-- Sauvegarde automatique
	task.spawn(function()
		while true do
			task.wait(GameConfig.Data.AutosaveInterval)
			for player in pairs(sessions) do
				DataService.Save(player)
				task.wait(0.5)
			end
		end
	end)
end

-- Charge le profil (bloquant). Retourne la session { Data, Loaded }.
function DataService.Load(player)
	local session = { Data = defaultProfile(), Loaded = false }
	sessions[player] = session

	if not store then
		warn("[DataService] Pas de DataStore : " .. player.Name .. " joue sans sauvegarde.")
		return session
	end

	local success, data = false, nil
	for attempt = 1, GameConfig.Data.LoadRetries do
		success, data = pcall(store.GetAsync, store, keyFor(player))
		if success then
			break
		end
		warn(string.format("[DataService] Échec chargement %s (essai %d) : %s", player.Name, attempt, tostring(data)))
		task.wait(attempt)
	end

	-- Le joueur est parti pendant le chargement
	if sessions[player] ~= session then
		return session
	end

	if success then
		if type(data) == "table" then
			session.Data = Util.Reconcile(data, defaultProfile())
		end
		session.Loaded = true
	else
		warn("[DataService] Sauvegarde DÉSACTIVÉE pour " .. player.Name .. " (chargement impossible).")
	end
	return session
end

function DataService.Get(player)
	local session = sessions[player]
	return session and session.Data or nil
end

function DataService.IsLoaded(player)
	local session = sessions[player]
	return session ~= nil and session.Loaded
end

function DataService.Save(player)
	local session = sessions[player]
	if not session or not session.Loaded or not store then
		return false
	end
	local data = session.Data
	local ok, err = pcall(store.UpdateAsync, store, keyFor(player), function()
		return data
	end)
	if not ok then
		warn("[DataService] Échec sauvegarde " .. player.Name .. " : " .. tostring(err))
	end
	return ok
end

return DataService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX23"><Properties><string name="Name">InventoryService</string><ProtectedString name="Source"><![CDATA[--[[
	InventoryService (ModuleScript)
	Emplacement : ServerScriptService > Services > InventoryService

	Œufs possédés : ajout (achat), équiper / retirer, "Équiper les meilleurs", vente.
	Toutes les vérifications sont faites ici, côté serveur.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local GameConfig = require(ReplicatedStorage.Config.GameConfig)
local EggConfig = require(ReplicatedStorage.Config.EggConfig)
local RankConfig = require(ReplicatedStorage.Config.RankConfig)
local CombatMath = require(ReplicatedStorage.Shared.CombatMath)
local Util = require(ReplicatedStorage.Shared.Util)

local DataService = require(ServerScriptService.Services.DataService)
local PlayerService = require(ServerScriptService.Services.PlayerService)
local CompanionService = require(ServerScriptService.Services.CompanionService)
local RequestRouter = require(ServerScriptService.Services.RequestRouter)

local InventoryService = {}

local function isEquipped(profile, eggId)
	return table.find(profile.Equipped, eggId) ~= nil
end

local function unequip(profile, eggId)
	local index = table.find(profile.Equipped, eggId)
	if index then
		table.remove(profile.Equipped, index)
		return true
	end
	return false
end

function InventoryService.GetMaxEquipped(profile)
	return RankConfig.GetMaxEquipped(profile.TotalEarned)
end

-- Prix de revente d'un œuf
function InventoryService.GetSellPrice(item)
	return math.max(1, math.floor(EggConfig.GetPrice(item.Rarity, item.Variant) * GameConfig.Sell.RefundRatio))
end

-- Ajoute un œuf au profil (après un achat validé). Équipe automatiquement s'il reste une place.
function InventoryService.AddEgg(player, rarityId, variantId)
	local profile = DataService.Get(player)
	if not profile then
		return nil
	end
	local item = { Id = "e" .. profile.NextEggId, Rarity = rarityId, Variant = variantId }
	profile.NextEggId = profile.NextEggId + 1
	table.insert(profile.Eggs, item)
	profile.Discovered[EggConfig.GetIndexKey(rarityId, variantId)] = true

	if #profile.Equipped < InventoryService.GetMaxEquipped(profile) then
		table.insert(profile.Equipped, item.Id)
	end
	CompanionService.Refresh(player)
	PlayerService.Push(player)
	return item
end

local function finish(player)
	CompanionService.Refresh(player)
	PlayerService.Push(player)
end

function InventoryService.Init()
	RequestRouter.Register("EquipEgg", function(player, payload)
		local profile = DataService.Get(player)
		if not profile then
			return false, "Profil non chargé"
		end
		local item = type(payload.id) == "string" and CombatMath.FindEgg(profile, payload.id)
		if not item then
			return false, "Œuf introuvable"
		end
		if isEquipped(profile, item.Id) then
			return false, "Déjà équipé"
		end
		local max = InventoryService.GetMaxEquipped(profile)
		if #profile.Equipped >= max then
			return false, "Limite atteinte : " .. max .. " œufs équipés (monte en rang pour en équiper plus)"
		end
		table.insert(profile.Equipped, item.Id)
		finish(player)
		return true, EggConfig.GetDisplayName(item.Rarity, item.Variant) .. " équipé"
	end)

	RequestRouter.Register("UnequipEgg", function(player, payload)
		local profile = DataService.Get(player)
		if not profile then
			return false, "Profil non chargé"
		end
		if type(payload.id) ~= "string" or not unequip(profile, payload.id) then
			return false, "Cet œuf n'est pas équipé"
		end
		finish(player)
		return true, "Œuf retiré"
	end)

	RequestRouter.Register("EquipBest", function(player)
		local profile = DataService.Get(player)
		if not profile then
			return false, "Profil non chargé"
		end
		local sorted = table.clone(profile.Eggs)
		table.sort(sorted, function(a, b)
			return CombatMath.GetEggItemDPS(a) > CombatMath.GetEggItemDPS(b)
		end)
		local max = InventoryService.GetMaxEquipped(profile)
		profile.Equipped = {}
		for i = 1, math.min(max, #sorted) do
			table.insert(profile.Equipped, sorted[i].Id)
		end
		finish(player)
		return true, "Meilleurs œufs équipés (" .. #profile.Equipped .. "/" .. max .. ")"
	end)

	RequestRouter.Register("SellEgg", function(player, payload)
		local profile = DataService.Get(player)
		if not profile then
			return false, "Profil non chargé"
		end
		local item = type(payload.id) == "string" and CombatMath.FindEgg(profile, payload.id)
		if not item then
			return false, "Œuf introuvable"
		end
		local price = InventoryService.GetSellPrice(item)
		unequip(profile, item.Id)
		table.remove(profile.Eggs, table.find(profile.Eggs, item))
		PlayerService.AddCash(player, price, false)
		finish(player)
		return true, EggConfig.GetDisplayName(item.Rarity, item.Variant) .. " vendu pour " .. Util.FormatNumber(price) .. " $"
	end)

	RequestRouter.Register("SellUnequipped", function(player)
		local profile = DataService.Get(player)
		if not profile then
			return false, "Profil non chargé"
		end
		local total, count = 0, 0
		local kept = {}
		for _, item in ipairs(profile.Eggs) do
			if isEquipped(profile, item.Id) then
				table.insert(kept, item)
			else
				total = total + InventoryService.GetSellPrice(item)
				count = count + 1
			end
		end
		if count == 0 then
			return false, "Aucun œuf non équipé à vendre"
		end
		profile.Eggs = kept
		PlayerService.AddCash(player, total, false)
		finish(player)
		return true, count .. " œuf(s) vendu(s) pour " .. Util.FormatNumber(total) .. " $"
	end)
end

return InventoryService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX24"><Properties><string name="Name">PlayerService</string><ProtectedString name="Source"><![CDATA[--[[
	PlayerService (ModuleScript)
	Emplacement : ServerScriptService > Services > PlayerService

	Arrivée / départ des joueurs, leaderstats, envoi du profil au client,
	argent (AddCash / SpendCash) et rangs.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local GameConfig = require(ReplicatedStorage.Config.GameConfig)
local RankConfig = require(ReplicatedStorage.Config.RankConfig)
local CombatMath = require(ReplicatedStorage.Shared.CombatMath)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Util = require(ReplicatedStorage.Shared.Util)

local DataService = require(ServerScriptService.Services.DataService)
local CompanionService = require(ServerScriptService.Services.CompanionService)
local RequestRouter = require(ServerScriptService.Services.RequestRouter)
local SwordBuilder = require(ServerScriptService.Builders.SwordBuilder)

local PlayerService = {}

local ProfileUpdated = Remotes.Get("ProfileUpdated")
local Notify = Remotes.Get("Notify")

-- Message affiché en haut de l'écran du joueur
function PlayerService.Notify(player, message, color)
	Notify:FireClient(player, message, color)
end

-- Envoie une copie du profil au client et met à jour les attributs publics
function PlayerService.Push(player)
	local profile = DataService.Get(player)
	if not profile then
		return
	end
	local tierIndex = CombatMath.GetTier(CombatMath.GetTotalDPS(profile))
	player:SetAttribute("Tier", tierIndex)
	player:SetAttribute("Effect", profile.EquippedEffect or "")
	local rankId, rank = RankConfig.GetRank(profile.TotalEarned)
	player:SetAttribute("Rank", rankId)

	local leaderstats = player:FindFirstChild("leaderstats")
	if leaderstats then
		leaderstats.Cash.Value = math.floor(profile.Cash)
		leaderstats.Rang.Value = rank.Name
	end
	ProfileUpdated:FireClient(player, profile)
end

-- Ajoute de l'argent. countsForRank = true pour l'argent gagné en combat.
function PlayerService.AddCash(player, amount, countsForRank)
	local profile = DataService.Get(player)
	if not profile or amount == 0 then
		return
	end
	profile.Cash = profile.Cash + amount
	if countsForRank and amount > 0 then
		local oldRank = RankConfig.GetRank(profile.TotalEarned)
		profile.TotalEarned = profile.TotalEarned + amount
		local newRank, def = RankConfig.GetRank(profile.TotalEarned)
		if newRank > oldRank then
			PlayerService.Notify(player, "🏆 Nouveau rang : " .. def.Name .. " ! (" .. def.MaxEquipped .. " œufs équipables)", Color3.fromRGB(255, 215, 0))
		end
	end
	PlayerService.Push(player)
end

-- Retire de l'argent si le joueur en a assez. Retourne true si réussi.
function PlayerService.SpendCash(player, amount)
	local profile = DataService.Get(player)
	if not profile or profile.Cash < amount then
		return false
	end
	profile.Cash = profile.Cash - amount
	return true
end

local function onCharacterAdded(player, character)
	local profile = DataService.Get(player)
	if not profile then
		return
	end
	character:WaitForChild("HumanoidRootPart", 10)
	task.wait(0.2) -- laisse le personnage finir de se charger
	if character.Parent then
		SwordBuilder.Attach(character, profile.EquippedSword, profile.EquippedEffect)
	end
end

local function onPlayerAdded(player)
	local session = DataService.Load(player)
	if player.Parent ~= Players then
		return
	end
	local profile = session.Data

	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	local cash = Instance.new("IntValue")
	cash.Name = "Cash"
	cash.Value = math.floor(profile.Cash)
	cash.Parent = leaderstats
	local rang = Instance.new("StringValue")
	rang.Name = "Rang"
	rang.Parent = leaderstats
	leaderstats.Parent = player

	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end)
	if player.Character then
		task.spawn(onCharacterAdded, player, player.Character)
	end

	CompanionService.Refresh(player)
	PlayerService.Push(player)

	if not session.Loaded then
		task.delay(3, function()
			PlayerService.Notify(player, "⚠️ Données non chargées : la sauvegarde est désactivée pour cette session.", Color3.fromRGB(255, 120, 120))
		end)
	else
		task.delay(2, function()
			PlayerService.Notify(player, "Bienvenue " .. player.DisplayName .. " ! Frappe les slimes pour gagner de l'argent.", Color3.fromRGB(255, 255, 255))
		end)
	end
end

function PlayerService.Init()
	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayerAdded, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		CompanionService.Remove(player)
	end)

	-- Le client demande son profil au démarrage (au cas où il aurait raté le premier envoi)
	RequestRouter.Register("GetProfile", function(player)
		local profile = DataService.Get(player)
		if not profile then
			return false, "Profil en cours de chargement"
		end
		return true, nil, profile
	end)

	-- Bouton Home : retour au point de départ
	RequestRouter.Register("GoHome", function(player)
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if not root then
			return false, "Personnage introuvable"
		end
		character:PivotTo(CFrame.new(GameConfig.SpawnPosition))
		return true, "Retour à la maison"
	end)
end

return PlayerService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX25"><Properties><string name="Name">RequestRouter</string><ProtectedString name="Source"><![CDATA[--[[
	RequestRouter (ModuleScript)
	Emplacement : ServerScriptService > Services > RequestRouter

	Une seule RemoteFunction "Request" pour toutes les actions du client.
	Chaque service enregistre ses actions :  Router.Register("BuySword", function(player, payload) ... end)
	Le gestionnaire retourne : ok (bool), message (texte), data (facultatif).
	Le client reçoit toujours une table { ok = ..., message = ..., data = ... }.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local RequestRouter = {}

local handlers = {}
local lastRequest = {} -- anti-spam : [player] = os.clock()

function RequestRouter.Register(action, handler)
	handlers[action] = handler
end

function RequestRouter.Init()
	local request = Remotes.Get("Request")
	request.OnServerInvoke = function(player, action, payload)
		if type(action) ~= "string" then
			return { ok = false, message = "Requête invalide" }
		end
		local now = os.clock()
		if now - (lastRequest[player] or 0) < 0.05 then
			return { ok = false, message = "Trop rapide !" }
		end
		lastRequest[player] = now

		local handler = handlers[action]
		if not handler then
			return { ok = false, message = "Action inconnue : " .. action }
		end
		if type(payload) ~= "table" then
			payload = {}
		end

		local success, ok, message, data = pcall(handler, player, payload)
		if not success then
			warn("[RequestRouter] Erreur dans " .. action .. " : " .. tostring(ok))
			return { ok = false, message = "Erreur serveur" }
		end
		return { ok = ok and true or false, message = message, data = data }
	end

	game:GetService("Players").PlayerRemoving:Connect(function(player)
		lastRequest[player] = nil
	end)
end

return RequestRouter
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX26"><Properties><string name="Name">ShopService</string><ProtectedString name="Source"><![CDATA[--[[
	ShopService (ModuleScript)
	Emplacement : ServerScriptService > Services > ShopService

	Boutique : achat / équipement des épées et des effets d'attaque (cosmétiques).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local SwordConfig = require(ReplicatedStorage.Config.SwordConfig)
local EffectConfig = require(ReplicatedStorage.Config.EffectConfig)
local Util = require(ReplicatedStorage.Shared.Util)

local DataService = require(ServerScriptService.Services.DataService)
local PlayerService = require(ServerScriptService.Services.PlayerService)
local RequestRouter = require(ServerScriptService.Services.RequestRouter)
local SwordBuilder = require(ServerScriptService.Builders.SwordBuilder)

local ShopService = {}

local function equipSword(player, profile, swordId)
	profile.EquippedSword = swordId
	if player.Character then
		SwordBuilder.Attach(player.Character, swordId, profile.EquippedEffect)
	end
	PlayerService.Push(player)
end

local function equipEffect(player, profile, effectId)
	profile.EquippedEffect = effectId or ""
	if player.Character then
		SwordBuilder.ApplyEffect(player.Character, profile.EquippedEffect)
	end
	PlayerService.Push(player)
end

function ShopService.Init()
	RequestRouter.Register("BuySword", function(player, payload)
		local profile = DataService.Get(player)
		if not profile then
			return false, "Profil non chargé"
		end
		local def = type(payload.id) == "string" and SwordConfig.Get(payload.id)
		if not def then
			return false, "Épée inconnue"
		end
		if table.find(profile.Swords, def.Id) then
			return false, "Tu possèdes déjà cette épée"
		end
		if not PlayerService.SpendCash(player, def.Price) then
			return false, "Pas assez d'argent (" .. Util.FormatNumber(def.Price) .. " $)"
		end
		table.insert(profile.Swords, def.Id)
		equipSword(player, profile, def.Id)
		return true, def.Name .. " achetée et équipée !"
	end)

	RequestRouter.Register("EquipSword", function(player, payload)
		local profile = DataService.Get(player)
		if not profile then
			return false, "Profil non chargé"
		end
		local def = type(payload.id) == "string" and SwordConfig.Get(payload.id)
		if not def or not table.find(profile.Swords, def.Id) then
			return false, "Tu ne possèdes pas cette épée"
		end
		equipSword(player, profile, def.Id)
		return true, def.Name .. " équipée"
	end)

	RequestRouter.Register("BuyEffect", function(player, payload)
		local profile = DataService.Get(player)
		if not profile then
			return false, "Profil non chargé"
		end
		local def = type(payload.id) == "string" and EffectConfig.Get(payload.id)
		if not def then
			return false, "Effet inconnu"
		end
		if table.find(profile.Effects, def.Id) then
			return false, "Tu possèdes déjà cet effet"
		end
		if not PlayerService.SpendCash(player, def.Price) then
			return false, "Pas assez d'argent (" .. Util.FormatNumber(def.Price) .. " $)"
		end
		table.insert(profile.Effects, def.Id)
		equipEffect(player, profile, def.Id)
		return true, "Effet " .. def.Name .. " acheté et équipé (cosmétique)"
	end)

	-- id = "" ou absent pour retirer l'effet
	RequestRouter.Register("EquipEffect", function(player, payload)
		local profile = DataService.Get(player)
		if not profile then
			return false, "Profil non chargé"
		end
		if payload.id == nil or payload.id == "" then
			equipEffect(player, profile, "")
			return true, "Effet retiré"
		end
		local def = type(payload.id) == "string" and EffectConfig.Get(payload.id)
		if not def or not table.find(profile.Effects, def.Id) then
			return false, "Tu ne possèdes pas cet effet"
		end
		equipEffect(player, profile, def.Id)
		return true, "Effet " .. def.Name .. " équipé"
	end)
end

return ShopService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX27"><Properties><string name="Name">SlimeService</string><ProtectedString name="Source"><![CDATA[--[[
	SlimeService (ModuleScript)
	Emplacement : ServerScriptService > Services > SlimeService

	Fait apparaître les slimes dans leurs zones, les fait sautiller, gère leurs
	points de vie, leur mort, la répartition des récompenses et la réapparition.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local SlimeConfig = require(ReplicatedStorage.Config.SlimeConfig)
local DataService = require(ServerScriptService.Services.DataService)
local PlayerService = require(ServerScriptService.Services.PlayerService)
local SlimeBuilder = require(ServerScriptService.Builders.SlimeBuilder)

local SlimeService = {}

local slimesFolder = workspace:WaitForChild("Slimes")
local states = {} -- [model] = state
local random = Random.new()

local function groundHeight(def)
	return SlimeBuilder.GetBodySize(def).Y / 2 + 0.05
end

local spawnSlime -- défini plus bas

-- Un saut vers un point aléatoire de la zone
local function hop(state)
	state.Hopping = true
	local def = state.Def
	local model = state.Model
	local startPosition = model:GetPivot().Position

	local angle = random:NextNumber(0, math.pi * 2)
	local distance = random:NextNumber(def.Size * 0.6, def.Size * 1.6)
	local target = startPosition + Vector3.new(math.cos(angle), 0, math.sin(angle)) * distance
	-- Reste dans la zone
	local fromHome = Vector3.new(target.X - state.Home.X, 0, target.Z - state.Home.Z)
	if fromHome.Magnitude > def.WanderRadius then
		target = state.Home + fromHome.Unit * def.WanderRadius * 0.9
	end
	target = Vector3.new(target.X, groundHeight(def), target.Z)

	local flat = Vector3.new(target.X - startPosition.X, 0, target.Z - startPosition.Z)
	local rotation = model:GetPivot().Rotation
	if flat.Magnitude > 0.05 then
		rotation = CFrame.lookAt(Vector3.zero, flat).Rotation
	end

	local duration = 0.5
	local startTime = os.clock()
	while state.Alive and model.Parent do
		local progress = math.min((os.clock() - startTime) / duration, 1)
		local position = startPosition:Lerp(target, progress) + Vector3.new(0, math.sin(progress * math.pi) * def.Size * 0.45, 0)
		model:PivotTo(CFrame.new(position) * rotation)
		if progress >= 1 then
			break
		end
		RunService.Heartbeat:Wait()
	end
	state.NextHop = os.clock() + def.HopInterval * random:NextNumber(0.7, 1.4)
	state.Hopping = false
end

-- Mort : récompenses réparties selon les dégâts de chacun, puis réapparition
local function kill(state)
	if not state.Alive then
		return
	end
	state.Alive = false -- empêche toute double récompense
	local model = state.Model
	local def = state.Def
	model:SetAttribute("Alive", false)
	states[model] = nil

	local totalDamage = 0
	for _, damage in pairs(state.Damage) do
		totalDamage = totalDamage + damage
	end
	if totalDamage > 0 then
		for userId, damage in pairs(state.Damage) do
			local player = Players:GetPlayerByUserId(userId)
			if player then
				local share = math.max(1, math.floor(def.Reward * damage / totalDamage + 0.5))
				local profile = DataService.Get(player)
				if profile then
					profile.Kills = profile.Kills + 1
				end
				PlayerService.AddCash(player, share, true)
			end
		end
	end

	task.spawn(function()
		SlimeBuilder.PlayDeath(model)
		model:Destroy()
		task.delay(def.RespawnTime, function()
			spawnSlime(def, state.Home)
		end)
	end)
end

-- Applique des dégâts. Retourne true si le coup a compté.
function SlimeService.ApplyDamage(state, player, amount)
	if not state or not state.Alive or amount <= 0 then
		return false
	end
	local dealt = math.min(amount, state.Health)
	state.Health = state.Health - dealt
	state.Damage[player.UserId] = (state.Damage[player.UserId] or 0) + dealt

	local model = state.Model
	model:SetAttribute("Health", math.max(0, state.Health))
	SlimeBuilder.UpdateHealth(model, state.Health, state.Def.Health)
	-- (le flash et la compression du coup sont animés par chaque client : SlimeAnimator)
	if state.Health <= 0 then
		kill(state)
	end
	return true
end

spawnSlime = function(def, home)
	local model = SlimeBuilder.Build(def)
	local state = {
		Model = model,
		Def = def,
		Home = home,
		Health = def.Health,
		Damage = {}, -- [userId] = dégâts infligés
		Alive = true,
		Hopping = false,
		NextHop = os.clock() + random:NextNumber(0.5, def.HopInterval),
	}
	model:PivotTo(CFrame.new(home.X, groundHeight(def), home.Z) * CFrame.Angles(0, random:NextNumber(0, math.pi * 2), 0))
	model.Parent = slimesFolder
	states[model] = state
	return state
end

function SlimeService.GetState(model)
	return states[model]
end

-- Slime vivant le plus proche d'une position, dans une portée donnée
function SlimeService.GetNearest(position, range)
	local best, bestDistance = nil, range
	for _, state in pairs(states) do
		if state.Alive and state.Model.Parent then
			local distance = (state.Model:GetPivot().Position - position).Magnitude - state.Def.Size / 2
			if distance <= bestDistance then
				best = state
				bestDistance = distance
			end
		end
	end
	return best
end

function SlimeService.Init()
	for _, def in ipairs(SlimeConfig.List) do
		for i = 1, def.Count do
			local angle = (i / def.Count) * math.pi * 2
			local radius = def.Count == 1 and 0 or def.ZoneRadius * 0.5
			local home = def.ZonePosition + Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
			spawnSlime(def, home)
		end
	end

	-- Déclenche les sauts
	RunService.Heartbeat:Connect(function()
		local now = os.clock()
		for _, state in pairs(states) do
			if state.Alive and not state.Hopping and now >= state.NextHop then
				task.spawn(hop, state)
			end
		end
	end)
end

return SlimeService
