<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Meta name="ExplicitAutoJoints">true</Meta><External>null</External><External>nil</External><Item class="Folder" referent="RBX8"><Properties><string name="Name">Config</string></Properties><Item class="ModuleScript" referent="RBX1"><Properties><string name="Name">EffectConfig</string><ProtectedString name="Source"><![CDATA[--[[
	EffectConfig (ModuleScript)
	Emplacement : ReplicatedStorage > Config > EffectConfig

	Effets d'attaque (traînée de l'épée + impact sur le slime).
	100 % COSMÉTIQUES : aucun bonus de dégâts.
]]

local EffectConfig = {}

local function sequence(colors)
	local keypoints = {}
	for index, color in ipairs(colors) do
		local time = (index - 1) / math.max(1, #colors - 1)
		table.insert(keypoints, ColorSequenceKeypoint.new(time, color))
	end
	return ColorSequence.new(keypoints)
end

EffectConfig.Description = "Effet purement cosmétique : ne change pas les dégâts."

EffectConfig.List = {
	{
		Id = "Fire",
		Name = "Feu",
		Icon = "🔥",
		Price = 500,
		TrailColor = sequence({ Color3.fromRGB(255, 200, 60), Color3.fromRGB(255, 110, 0), Color3.fromRGB(200, 30, 0) }),
		ImpactColor = Color3.fromRGB(255, 120, 20),
		LightColor = Color3.fromRGB(255, 120, 20),
		LightBrightness = 2,
		ParticleSize = 0.9,
		ParticleSpeed = 8,
		ParticleLifetime = 0.5,
		Rainbow = false,
	},
	{
		Id = "Ice",
		Name = "Glace",
		Icon = "❄️",
		Price = 1500,
		TrailColor = sequence({ Color3.fromRGB(255, 255, 255), Color3.fromRGB(150, 230, 255), Color3.fromRGB(60, 160, 255) }),
		ImpactColor = Color3.fromRGB(170, 235, 255),
		LightColor = Color3.fromRGB(150, 220, 255),
		LightBrightness = 1.5,
		ParticleSize = 0.7,
		ParticleSpeed = 4,
		ParticleLifetime = 0.9,
		Rainbow = false,
	},
	{
		Id = "Lightning",
		Name = "Éclairs",
		Icon = "⚡",
		Price = 5000,
		TrailColor = sequence({ Color3.fromRGB(255, 255, 255), Color3.fromRGB(255, 255, 120), Color3.fromRGB(255, 220, 0) }),
		ImpactColor = Color3.fromRGB(255, 255, 140),
		LightColor = Color3.fromRGB(255, 255, 160),
		LightBrightness = 4,
		ParticleSize = 0.5,
		ParticleSpeed = 18,
		ParticleLifetime = 0.3,
		Rainbow = false,
	},
	{
		Id = "Shadow",
		Name = "Ombres",
		Icon = "🌑",
		Price = 15000,
		TrailColor = sequence({ Color3.fromRGB(120, 0, 180), Color3.fromRGB(50, 0, 80), Color3.fromRGB(10, 0, 15) }),
		ImpactColor = Color3.fromRGB(90, 0, 140),
		LightColor = Color3.fromRGB(120, 0, 180),
		LightBrightness = 1,
		ParticleSize = 1.3,
		ParticleSpeed = 3,
		ParticleLifetime = 1.1,
		Rainbow = false,
	},
	{
		Id = "Light",
		Name = "Lumière",
		Icon = "✨",
		Price = 50000,
		TrailColor = sequence({ Color3.fromRGB(255, 255, 255), Color3.fromRGB(255, 250, 200), Color3.fromRGB(255, 220, 100) }),
		ImpactColor = Color3.fromRGB(255, 245, 190),
		LightColor = Color3.fromRGB(255, 240, 180),
		LightBrightness = 6,
		ParticleSize = 1.0,
		ParticleSpeed = 10,
		ParticleLifetime = 0.7,
		Rainbow = false,
	},
	{
		Id = "Rainbow",
		Name = "Arc-en-ciel",
		Icon = "🌈",
		Price = 150000,
		TrailColor = sequence({
			Color3.fromRGB(255, 0, 0),
			Color3.fromRGB(255, 170, 0),
			Color3.fromRGB(255, 255, 0),
			Color3.fromRGB(0, 255, 80),
			Color3.fromRGB(0, 150, 255),
			Color3.fromRGB(170, 0, 255),
		}),
		ImpactColor = Color3.fromRGB(255, 255, 255),
		LightColor = Color3.fromRGB(255, 255, 255),
		LightBrightness = 3,
		ParticleSize = 1.0,
		ParticleSpeed = 12,
		ParticleLifetime = 0.8,
		Rainbow = true, -- la couleur tourne avec le temps
	},
}

local byId = {}
for index, def in ipairs(EffectConfig.List) do
	def.Index = index
	byId[def.Id] = def
end

function EffectConfig.Get(id)
	if id == nil or id == "" then
		return nil
	end
	return byId[id]
end

return EffectConfig
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX2"><Properties><string name="Name">EggConfig</string><ProtectedString name="Source"><![CDATA[--[[
	EggConfig (ModuleScript)
	Emplacement : ReplicatedStorage > Config > EggConfig

	Les 6 raretés d'œufs et leurs variantes (Normal, Argent, Or).
	- Price : prix sur le tapis
	- Weight : probabilité relative d'apparition (la somme fait 100 ici)
	- DPS : dégâts par seconde ajoutés quand l'œuf est équipé
	- AttackInterval : secondes entre deux attaques de l'œuf
	  (dégâts par attaque = DPS x AttackInterval, calculé dans CombatMath)
]]

local EggConfig = {}

-- Apparence 3D des œufs : "Smooth" (œuf lisse et arrondi) ou "Blocks" (couches de blocs, comme la photo)
EggConfig.Style = "Smooth"

EggConfig.Rarities = {
	{
		Id = "Common",
		Name = "Commun",
		Price = 10,
		Weight = 50,
		DPS = 1,
		AttackInterval = 1.2,
		Color = Color3.fromRGB(236, 224, 196),
		SpotColor = Color3.fromRGB(200, 185, 150),
		Material = Enum.Material.SmoothPlastic,
		Spots = 0,
		Glow = false,
		Sparkles = false,
		Aura = false,
	},
	{
		Id = "Uncommon",
		Name = "Peu commun",
		Price = 50,
		Weight = 28,
		DPS = 3,
		AttackInterval = 1.1,
		Color = Color3.fromRGB(120, 210, 110),
		SpotColor = Color3.fromRGB(50, 140, 60),
		Material = Enum.Material.SmoothPlastic,
		Spots = 4,
		Glow = false,
		Sparkles = false,
		Aura = false,
	},
	{
		Id = "Rare",
		Name = "Rare",
		Price = 250,
		Weight = 13,
		DPS = 10,
		AttackInterval = 1.0,
		Color = Color3.fromRGB(70, 140, 255),
		SpotColor = Color3.fromRGB(190, 235, 255),
		Material = Enum.Material.SmoothPlastic,
		Spots = 6,
		Glow = true,
		Sparkles = false,
		Aura = false,
	},
	{
		Id = "Epic",
		Name = "Épique",
		Price = 1500,
		Weight = 6,
		DPS = 35,
		AttackInterval = 0.9,
		Color = Color3.fromRGB(160, 70, 230),
		SpotColor = Color3.fromRGB(255, 120, 255),
		Material = Enum.Material.Glass,
		Spots = 7,
		Glow = true,
		Sparkles = false,
		Aura = false,
	},
	{
		Id = "Legendary",
		Name = "Légendaire",
		Price = 10000,
		Weight = 2.5,
		DPS = 120,
		AttackInterval = 0.8,
		Color = Color3.fromRGB(255, 170, 30),
		SpotColor = Color3.fromRGB(255, 245, 140),
		Material = Enum.Material.Metal,
		Spots = 8,
		Glow = true,
		Sparkles = true,
		Aura = false,
	},
	{
		Id = "Mythic",
		Name = "Mythique",
		Price = 75000,
		Weight = 0.5,
		DPS = 450,
		AttackInterval = 0.7,
		Color = Color3.fromRGB(45, 10, 65),
		SpotColor = Color3.fromRGB(255, 40, 130),
		Material = Enum.Material.SmoothPlastic,
		Spots = 10,
		Glow = true,
		Sparkles = true,
		Aura = true,
	},
}

-- Variantes : Normal (sans nom), Argent, Or
EggConfig.Variants = {
	{ Id = "Normal", Name = "", Weight = 85, PriceMult = 1, PowerMult = 1, Tint = nil, Material = nil, Sparkles = false, LabelColor = Color3.fromRGB(255, 255, 255) },
	{ Id = "Silver", Name = "Argent", Weight = 12, PriceMult = 2, PowerMult = 1.5, Tint = Color3.fromRGB(215, 215, 225), Material = Enum.Material.Metal, Sparkles = false, LabelColor = Color3.fromRGB(220, 220, 235) },
	{ Id = "Gold", Name = "Or", Weight = 3, PriceMult = 4, PowerMult = 2.5, Tint = Color3.fromRGB(255, 215, 0), Material = Enum.Material.Metal, Sparkles = true, LabelColor = Color3.fromRGB(255, 220, 60) },
}

local rarityById = {}
for index, rarity in ipairs(EggConfig.Rarities) do
	rarity.Index = index
	rarityById[rarity.Id] = rarity
end

local variantById = {}
for index, variant in ipairs(EggConfig.Variants) do
	variant.Index = index
	variantById[variant.Id] = variant
end

function EggConfig.GetRarity(rarityId)
	return rarityById[rarityId]
end

function EggConfig.GetVariant(variantId)
	return variantById[variantId or "Normal"] or variantById.Normal
end

-- Prix d'achat d'un œuf (rareté + variante)
function EggConfig.GetPrice(rarityId, variantId)
	local rarity = EggConfig.GetRarity(rarityId)
	local variant = EggConfig.GetVariant(variantId)
	if not rarity then
		return 0
	end
	return math.floor(rarity.Price * variant.PriceMult)
end

-- DPS apporté par un œuf équipé
function EggConfig.GetDPS(rarityId, variantId)
	local rarity = EggConfig.GetRarity(rarityId)
	local variant = EggConfig.GetVariant(variantId)
	if not rarity then
		return 0
	end
	return rarity.DPS * variant.PowerMult
end

-- Nom affiché : "Œuf Rare Argent"
function EggConfig.GetDisplayName(rarityId, variantId)
	local rarity = EggConfig.GetRarity(rarityId)
	local variant = EggConfig.GetVariant(variantId)
	if not rarity then
		return "Œuf inconnu"
	end
	local name = "Œuf " .. rarity.Name
	if variant.Name ~= "" then
		name = name .. " " .. variant.Name
	end
	return name
end

-- Clé utilisée par l'Index (collection) : "Rare_Silver"
function EggConfig.GetIndexKey(rarityId, variantId)
	return rarityId .. "_" .. (variantId or "Normal")
end

local function weightedRoll(list, random)
	local total = 0
	for _, entry in ipairs(list) do
		total = total + entry.Weight
	end
	local roll = random:NextNumber() * total
	for _, entry in ipairs(list) do
		roll = roll - entry.Weight
		if roll <= 0 then
			return entry
		end
	end
	return list[#list]
end

function EggConfig.RollRarity(random)
	return weightedRoll(EggConfig.Rarities, random)
end

function EggConfig.RollVariant(random)
	return weightedRoll(EggConfig.Variants, random)
end

return EggConfig
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX3"><Properties><string name="Name">GameConfig</string><ProtectedString name="Source"><![CDATA[--[[
	GameConfig (ModuleScript)
	Emplacement : ReplicatedStorage > Config > GameConfig

	Réglages généraux du jeu. Tout ce qui concerne le tapis roulant,
	le combat, la vente, les compagnons et la sauvegarde se règle ici.
]]

local GameConfig = {}

-- Argent de départ d'un nouveau joueur
GameConfig.StartCash = 0

-- Point d'apparition (le bouton Home ramène ici)
GameConfig.SpawnPosition = Vector3.new(0, 3, 55)

-- Tapis roulant
GameConfig.Conveyor = {
	Center = Vector3.new(0, 0, 25), -- centre du tapis (au niveau du sol)
	Direction = Vector3.new(1, 0, 0), -- sens de défilement des œufs
	Length = 70, -- longueur du tapis (studs)
	Width = 8, -- largeur du tapis
	BeltHeight = 1, -- épaisseur du tapis
	Speed = 5, -- vitesse des œufs (studs / seconde)
	SpawnInterval = 3, -- un nouvel œuf toutes les X secondes
	MaxEggs = 8, -- nombre maximum d'œufs sur le tapis
	BuyDistance = 12, -- distance maximale pour acheter (studs)
	EggScale = 1, -- taille des œufs sur le tapis
}

-- Combat
GameConfig.Combat = {
	CompanionRange = 28, -- portée des œufs équipés autour du joueur
	CombatTimeout = 8, -- les œufs attaquent pendant X s après le dernier coup du joueur
	CooldownTolerance = 0.75, -- tolérance réseau sur la cadence (0.75 = 25 % de marge)
	DistanceTolerance = 6, -- tolérance réseau sur la portée (studs)
}

-- Vente des œufs
GameConfig.Sell = {
	RefundRatio = 0.5, -- un œuf se revend 50 % de son prix
}

-- Compagnons (œufs équipés qui suivent le joueur)
GameConfig.Companion = {
	Scale = 0.55, -- taille des œufs compagnons
	BobHeight = 0.35, -- amplitude du flottement
	BobSpeed = 2.2, -- vitesse du flottement
	FollowSpeed = 7, -- réactivité du suivi (plus grand = plus rapide)
	-- Position de chaque emplacement par rapport au joueur (x = côté, y = hauteur, z = derrière)
	Offsets = {
		Vector3.new(-3, 1.5, 3),
		Vector3.new(3, 1.5, 3),
		Vector3.new(0, 2.2, 5.5),
		Vector3.new(-5, 1.5, 5.5),
		Vector3.new(5, 1.5, 5.5),
		Vector3.new(0, 3, 8),
	},
}

-- Sauvegarde
GameConfig.Data = {
	StoreName = "SlimeEggs_v1", -- changer ce nom remet toutes les sauvegardes à zéro
	AutosaveInterval = 120, -- sauvegarde automatique toutes les X secondes
	LoadRetries = 3,
}

return GameConfig
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX4"><Properties><string name="Name">IconConfig</string><ProtectedString name="Source"><![CDATA[--[[
	IconConfig (ModuleScript)
	Emplacement : ReplicatedStorage > Config > IconConfig

	Icônes de l'interface. Les images PNG sont fournies dans le dossier assets/icons/ du projet.

	COMMENT LES ACTIVER (une seule fois) :
	1. Studio > onglet View > Asset Manager > Bulk Import > sélectionne tous les PNG de assets/icons/
	   (ou Home > Game Settings > ... ; chaque image passe par la modération Roblox, quelques minutes).
	2. Dans l'Asset Manager, clic droit sur une image > "Copy ID to clipboard".
	3. Colle l'identifiant ci-dessous, sous la forme "rbxassetid://123456789".

	Tant qu'une entrée est vide (""), l'interface affiche l'emoji de secours à la place :
	le jeu fonctionne donc même sans uploader les images.
]]

local IconConfig = {}

IconConfig.Images = {
	Bag = "", -- assets/icons/bag.png
	Shop = "", -- assets/icons/shop.png
	Index = "", -- assets/icons/index.png
	Ranks = "", -- assets/icons/ranks.png
	Home = "", -- assets/icons/home.png
	Sell = "", -- assets/icons/sell.png
	Cash = "", -- assets/icons/cash.png (billet vert du HUD et des étiquettes du tapis)
	Sword = "", -- assets/icons/sword.png
	Egg = "", -- assets/icons/egg.png (œuf blanc, teinté selon la rareté)
	Attack = "", -- assets/icons/attack.png (bouton tactile)
	Star = "", -- assets/icons/star.png (bouton "Équiper les meilleurs")
	Close = "", -- assets/icons/close.png
	-- Effets d'attaque
	Fire = "", -- assets/icons/fire.png
	Ice = "", -- assets/icons/ice.png
	Lightning = "", -- assets/icons/lightning.png
	Shadow = "", -- assets/icons/shadow.png
	Light = "", -- assets/icons/light.png
	Rainbow = "", -- assets/icons/rainbow.png
}

-- Emoji utilisés quand l'image n'est pas renseignée
IconConfig.Fallback = {
	Bag = "🎒",
	Shop = "🛒",
	Index = "📖",
	Ranks = "📈",
	Home = "🏠",
	Sell = "💰",
	Cash = "$",
	Sword = "🗡️",
	Egg = "🥚",
	Attack = "⚔️",
	Star = "⭐",
	Close = "✕",
	Fire = "🔥",
	Ice = "❄️",
	Lightning = "⚡",
	Shadow = "🌑",
	Light = "✨",
	Rainbow = "🌈",
}

-- Retourne l'identifiant d'image ("" si absent)
function IconConfig.GetImage(name)
	local id = IconConfig.Images[name]
	if type(id) == "string" and id ~= "" then
		return id
	end
	return ""
end

function IconConfig.GetFallback(name)
	return IconConfig.Fallback[name] or "?"
end

function IconConfig.HasImage(name)
	return IconConfig.GetImage(name) ~= ""
end

return IconConfig
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX5"><Properties><string name="Name">RankConfig</string><ProtectedString name="Source"><![CDATA[--[[
	RankConfig (ModuleScript)
	Emplacement : ReplicatedStorage > Config > RankConfig

	Paliers de progression. Le rang dépend de l'argent TOTAL gagné en combat
	(les ventes d'œufs ne comptent pas). Chaque rang fixe le nombre
	maximum d'œufs équipés.
]]

local RankConfig = {}

RankConfig.List = {
	{ Id = 1, Name = "Débutant", Required = 0, MaxEquipped = 3, Color = Color3.fromRGB(200, 200, 200) },
	{ Id = 2, Name = "Chasseur", Required = 500, MaxEquipped = 3, Color = Color3.fromRGB(120, 220, 120) },
	{ Id = 3, Name = "Guerrier", Required = 5000, MaxEquipped = 4, Color = Color3.fromRGB(90, 160, 255) },
	{ Id = 4, Name = "Champion", Required = 50000, MaxEquipped = 4, Color = Color3.fromRGB(190, 90, 255) },
	{ Id = 5, Name = "Légende", Required = 500000, MaxEquipped = 5, Color = Color3.fromRGB(255, 180, 40) },
	{ Id = 6, Name = "Mythe", Required = 5000000, MaxEquipped = 6, Color = Color3.fromRGB(255, 70, 160) },
}

-- Retourne l'index du rang et sa définition
function RankConfig.GetRank(totalEarned)
	local current = RankConfig.List[1]
	for _, rank in ipairs(RankConfig.List) do
		if (totalEarned or 0) >= rank.Required then
			current = rank
		end
	end
	return current.Id, current
end

function RankConfig.GetMaxEquipped(totalEarned)
	local _, rank = RankConfig.GetRank(totalEarned)
	return rank.MaxEquipped
end

-- Prochain rang (nil si déjà au maximum)
function RankConfig.GetNextRank(totalEarned)
	local id = RankConfig.GetRank(totalEarned)
	return RankConfig.List[id + 1]
end

return RankConfig
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX6"><Properties><string name="Name">SlimeConfig</string><ProtectedString name="Source"><![CDATA[--[[
	SlimeConfig (ModuleScript)
	Emplacement : ReplicatedStorage > Config > SlimeConfig

	Les 6 catégories de slimes. Chaque catégorie possède sa propre zone sur la map.
	- Health : points de vie
	- Reward : argent donné à la mort (réparti selon les dégâts de chacun)
	- Size : diamètre du slime (studs)
	- Count : nombre de slimes dans la zone
	- RespawnTime : secondes avant réapparition
	- ZonePosition / ZoneRadius : emplacement de la zone sur la map
]]

